@page "/package/{publisherName}/{packageName}"
@page "/package/{publisherName}/{packageName}/{version?}"
@inject IApiClientService ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using MCPHub.WebApp.Components.UI.Search
@using MCPHub.WebApp.Components.UI.Packages
@using MCPHub.WebApp.Components.UI.Layout
@using MCPHub.WebApp.Components.UI.Models
@using MCPHub.WebApp.Components.UI.Analytics
@using MCPHub.WebApp.Components.UI.Security
@using MCPHub.WebApp.Services
@using MCPHub.Domain.Entities
@using MCPHub.Domain.ValueObjects

<PageTitle>@(_package?.Name ?? "Package") - MCP Hub</PageTitle>

@if (_package != null)
{
    <ResponsiveContainer MaxWidth="ContainerMaxWidth.ExtraLarge" FullHeight="true">
        <HeaderContent>
            <!-- Package Header -->
            <div class="package-detail-header">
                <div class="d-flex align-center mb-3">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                 Color="Color.Default"
                                 @onclick="@(() => Navigation.NavigateTo("/search"))"
                                 Title="Back to search"
                                 Class="mr-2" />
                    <MudBreadcrumbs Items="@GetBreadcrumbs()" Class="flex-grow-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.Share"
                                 Color="Color.Default"
                                 @onclick="SharePackage"
                                 Title="Share package" />
                </div>

                <div class="package-title-section mb-4">
                    <div class="d-flex justify-space-between align-start">
                        <div class="package-title-info">
                            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-1">
                                @_package.Publisher.Name/@_package.Name
                            </MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-3">
                                @_package.Description
                            </MudText>
                            
                            <!-- Package Metadata -->
                            <div class="package-metadata d-flex flex-wrap align-center gap-4 mb-3">
                                <div class="metadata-item d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Class="mr-1" />
                                    <MudText Typo="Typo.body2">v@(_selectedVersion ?? _package.LatestVersion)</MudText>
                                </div>
                                
                                <div class="metadata-item d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="mr-1" />
                                    <MudText Typo="Typo.body2">@FormatDownloads(_package.WeeklyDownloads)/week</MudText>
                                </div>
                                
                                <div class="metadata-item d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Class="mr-1" />
                                    <MudText Typo="Typo.body2">@_package.Rating.ToString("F1") (@GetReviewCount() reviews)</MudText>
                                </div>
                                
                                <div class="metadata-item d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                    <MudText Typo="Typo.body2">Updated @FormatLastUpdated(_package.LastUpdated)</MudText>
                                </div>

                                <div class="metadata-item d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                    <MudLink Href="@($"/publisher/{_package.Publisher.Name}")" Class="publisher-link">
                                        @_package.Publisher.DisplayName
                                        @if (_package.Publisher.IsVerified)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Verified" 
                                                   Color="Color.Success" 
                                                   Size="Size.Small" 
                                                   Class="ml-1" />
                                        }
                                    </MudLink>
                                </div>
                            </div>

                            <!-- Security and Trust Indicators -->
                            <div class="security-indicators d-flex align-center gap-3 mb-4">
                                <SecurityGradeBadge Grade="@_package.SecurityGrade" 
                                                  Score="@_package.SecurityScore"
                                                  DetailedReport="@_package.SecurityReport"
                                                  OnDetailClick="@ShowSecurityModal" />
                                
                                <TrustTierIndicator Tier="@_package.TrustTier" 
                                                  ShowProgressIndicator="true"
                                                  Progress="@_package.TrustProgress"
                                                  OnDetailsClick="@ShowTrustModal" />
                                
                                @if (_package.IsTrending)
                                {
                                    <MudChip T="string" 
                                           Color="Color.Success" 
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.TrendingUp">
                                        Trending
                                    </MudChip>
                                }
                            </div>

                            <!-- Package Tags -->
                            <div class="package-tags d-flex flex-wrap gap-2">
                                @foreach (var tag in _package.Tags)
                                {
                                    <MudChip T="string" 
                                           Color="Color.Primary" 
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="@(() => SearchByTag(tag))">
                                        @tag
                                    </MudChip>
                                }
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="package-actions">
                            <div class="install-section mb-3">
                                <MudButton Color="Color.Primary" 
                                         Variant="Variant.Filled"
                                         Size="Size.Large"
                                         StartIcon="@Icons.Material.Filled.Download"
                                         @onclick="InstallPackage"
                                         FullWidth="true"
                                         Class="mb-2">
                                    Install Package
                                </MudButton>
                                
                                <MudSelect T="string" 
                                         @bind-Value="@_selectedVersion"
                                         Label="Version"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         FullWidth="true">
                                    @foreach (var version in GetAvailableVersions())
                                    {
                                        <MudSelectItem Value="@version.Version">
                                            @version.Version
                                            @if (version.IsLatest) { <span> (Latest)</span> }
                                            @if (version.IsPrerelease) { <span> (Pre-release)</span> }
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <div class="secondary-actions d-flex gap-2">
                                <MudButton Color="@(_package.IsStarred ? Color.Warning : Color.Default)" 
                                         Variant="Variant.Outlined"
                                         StartIcon="@(_package.IsStarred ? Icons.Material.Filled.Star : Icons.Material.Outlined.Star)"
                                         @onclick="ToggleStar"
                                         FullWidth="true">
                                    @(_package.IsStarred ? "Starred" : "Star")
                                </MudButton>
                                
                                <MudButton Color="Color.Default" 
                                         Variant="Variant.Outlined"
                                         StartIcon="@Icons.Material.Filled.BugReport"
                                         @onclick="ReportIssue"
                                         FullWidth="true">
                                    Report
                                </MudButton>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Installation Command -->
                <MudPaper Class="installation-command pa-4 mb-4" Elevation="1">
                    <div class="d-flex justify-space-between align-center">
                        <div class="command-section flex-grow-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Installation Command</MudText>
                            <MudText Typo="Typo.body1" Class="command-text">
                                mcpm install @_package.Publisher.Name/@_package.Name@(string.IsNullOrEmpty(_selectedVersion) ? "" : $"@{_selectedVersion}")
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                     Color="Color.Primary"
                                     @onclick="CopyInstallCommand"
                                     Title="Copy to clipboard" />
                    </div>
                </MudPaper>
            </div>
        </HeaderContent>

        <MainContent>
            <!-- Package Tabs -->
            <MudTabs Elevation="1" Rounded="true" Centered="false" Color="Color.Primary" Class="package-tabs">
                <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Info">
                    <div class="overview-content">
                        <!-- README Content -->
                        <section class="readme-section mb-6">
                            <MudText Typo="Typo.h6" Class="mb-3">📖 Documentation</MudText>
                            <MudPaper Class="pa-4" Elevation="1">
                                <div class="readme-content">
                                    @((MarkupString)GetReadmeContent())
                                </div>
                            </MudPaper>
                        </section>

                        <!-- Package Statistics -->
                        <section class="statistics-section mb-6">
                            <MudText Typo="Typo.h6" Class="mb-3">📊 Package Statistics</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="12" md="8">
                                    <AnalyticsChart Title="Download Trends"
                                                   Subtitle="Downloads over the last 90 days"
                                                   ChartType="Components.UI.Models.ChartType.Line"
                                                   ChartSeries="@ChartSeriesConverter.ToMudBlazor(GetDownloadTrendData())"
                                                   XAxisLabels="@GetTimeLabels()"
                                                   ShowTimeRangeSelector="true"
                                                   ShowDataTable="false"
                                                   ShowSummary="true"
                                                   Height="300" />
                                </MudItem>
                                
                                <MudItem xs="12" md="4">
                                    <MudPaper Class="pa-4 h-100">
                                        <MudText Typo="Typo.h6" Class="mb-4">Key Metrics</MudText>
                                        
                                        <div class="metric-item mb-3">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2">Total Downloads</MudText>
                                                <MudText Typo="Typo.h6" Color="Color.Primary">@FormatDownloads(GetTotalDownloads())</MudText>
                                            </div>
                                        </div>
                                        
                                        <div class="metric-item mb-3">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2">GitHub Stars</MudText>
                                                <MudText Typo="Typo.h6" Color="Color.Warning">@GetGitHubStars()</MudText>
                                            </div>
                                        </div>
                                        
                                        <div class="metric-item mb-3">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2">Dependents</MudText>
                                                <MudText Typo="Typo.h6" Color="Color.Success">@GetDependentCount()</MudText>
                                            </div>
                                        </div>
                                        
                                        <div class="metric-item">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2">Last Scan</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@FormatLastUpdated(GetLastScanDate())</MudText>
                                            </div>
                                        </div>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </section>

                        <!-- Related Packages -->
                        <section class="related-packages-section">
                            <MudText Typo="Typo.h6" Class="mb-3">🔗 Related Packages</MudText>
                            <MudGrid Spacing="3">
                                @foreach (var relatedPackage in GetRelatedPackages())
                                {
                                    <MudItem xs="12" sm="6" md="4">
                                        <PackageCard Package="@relatedPackage" 
                                                   OnInstallClick="@HandleInstall"
                                                   OnDetailsClick="@HandleDetails"
                                                   OnStarClick="@HandleStar"
                                                   OnShareClick="@HandleShare"
                                                   OnMoreClick="@HandleMore" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </section>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
                    <SecurityVisualization SecurityReport="@_package.SecurityReport"
                                         SecurityHistory="@GetSecurityHistory()"
                                         OnDownloadSecurityReport="@DownloadSecurityReport"
                                         OnRequestNewScan="@RequestNewScan" />
                </MudTabPanel>

                <MudTabPanel Text="Installation" Icon="@Icons.Material.Filled.Download">
                    <InstallationInstructions PackageName="@_package.Name"
                                            PublisherName="@_package.Publisher.Name"
                                            AvailableVersions="@GetAvailableVersions()"
                                            OnInstallPackage="@InstallPackage"
                                            DocumentationUrl="@GetDocumentationUrl()"
                                            IssuesUrl="@GetIssuesUrl()"
                                            CommunityUrl="@GetCommunityUrl()"
                                            SupportUrl="@GetSupportUrl()" />
                </MudTabPanel>

                <MudTabPanel Text="Manifest" Icon="@Icons.Material.Filled.Description">
                    <ManifestVisualization Manifest="@GetPackageManifest()"
                                         OnViewToolDetails="@ShowToolDetails"
                                         OnTestTool="@TestTool"
                                         OnViewResource="@ViewResource"
                                         OnDownloadResource="@DownloadResource"
                                         OnViewPromptDetails="@ShowPromptDetails"
                                         OnTryPrompt="@TryPrompt"
                                         OnViewRawManifest="@ViewRawManifest"
                                         OnDownloadManifest="@DownloadManifest" />
                </MudTabPanel>

                <MudTabPanel Text="Security (Old)" Icon="@Icons.Material.Filled.Security" Style="display: none;">
                    <div class="security-content">
                        <!-- Security Overview -->
                        <section class="security-overview mb-6">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6">🔒 Security Analysis Report</MudText>
                                <div class="d-flex gap-2">
                                    <MudButton Color="Color.Primary" 
                                             Variant="Variant.Outlined"
                                             StartIcon="@Icons.Material.Filled.Download"
                                             @onclick="DownloadSecurityReport">
                                        Download Report
                                    </MudButton>
                                    <MudButton Color="Color.Secondary" 
                                             Variant="Variant.Outlined"
                                             StartIcon="@Icons.Material.Filled.Refresh"
                                             @onclick="RequestNewScan">
                                        Request New Scan
                                    </MudButton>
                                </div>
                            </div>

                            <!-- Security Grade Breakdown -->
                            <MudGrid Spacing="4">
                                <MudItem xs="12" md="8">
                                    <MudPaper Class="pa-4" Elevation="1">
                                        <div class="security-grade-breakdown">
                                            <div class="overall-grade mb-4">
                                                <div class="d-flex align-center justify-space-between">
                                                    <div>
                                                        <MudText Typo="Typo.h5" Color="Color.Primary">
                                                            Overall Grade: @_package.SecurityGrade
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                            Score: @_package.SecurityScore.ToString("F1")/10.0
                                                        </MudText>
                                                    </div>
                                                    <SecurityGradeBadge Grade="@_package.SecurityGrade" 
                                                                      Score="@_package.SecurityScore"
                                                                      ShowScore="true" />
                                                </div>
                                                
                                                <MudProgressLinear Value="@(_package.SecurityScore * 10)" 
                                                                 Color="@GetSecurityColor()"
                                                                 Size="Size.Large"
                                                                 Class="mt-2" />
                                            </div>

                                            <!-- Security Categories -->
                                            <div class="security-categories">
                                                @foreach (var category in GetSecurityCategories())
                                                {
                                                    <div class="security-category mb-3">
                                                        <div class="d-flex justify-space-between align-center mb-1">
                                                            <MudText Typo="Typo.body1">@category.Name</MudText>
                                                            <MudText Typo="Typo.body2" Color="@GetGradeColor(category.Grade)">
                                                                @category.Grade (@category.Score.ToString("F1")/10)
                                                            </MudText>
                                                        </div>
                                                        <MudProgressLinear Value="@(category.Score * 10)" 
                                                                         Color="@GetGradeColor(category.Grade)"
                                                                         Size="Size.Small" />
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                                            @category.Description
                                                        </MudText>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </MudPaper>
                                </MudItem>
                                
                                <MudItem xs="12" md="4">
                                    <MudPaper Class="pa-4 h-100" Elevation="1">
                                        <MudText Typo="Typo.h6" Class="mb-3">🛡️ Security Features</MudText>
                                        
                                        @foreach (var feature in GetSecurityFeatures())
                                        {
                                            <div class="security-feature d-flex align-center mb-2">
                                                <MudIcon Icon="@(feature.IsSupported ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                       Color="@(feature.IsSupported ? Color.Success : Color.Error)"
                                                       Size="Size.Small"
                                                       Class="mr-2" />
                                                <MudText Typo="Typo.body2">@feature.Name</MudText>
                                            </div>
                                        }
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </section>

                        <!-- Vulnerability Information -->
                        <section class="vulnerability-section mb-6">
                            <MudText Typo="Typo.h6" Class="mb-3">🔍 Vulnerability Assessment</MudText>
                            
                            @if (GetVulnerabilities().Any())
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                    <MudText>@GetVulnerabilities().Count vulnerability(s) found. Review details below.</MudText>
                                </MudAlert>
                                
                                @foreach (var vulnerability in GetVulnerabilities())
                                {
                                    <MudExpansionPanels MultiExpansion="true" Class="mb-2">
                                        <MudExpansionPanel>
                                            <TitleContent>
                                                <div class="d-flex align-center">
                                                    <MudIcon Icon="@GetVulnerabilityIcon(vulnerability.Severity)" 
                                                           Color="@GetVulnerabilityColor(vulnerability.Severity)"
                                                           Class="mr-3" />
                                                    <MudText>@vulnerability.Title</MudText>
                                                    <MudSpacer />
                                                    <MudChip T="string" 
                                                           Color="@GetVulnerabilityColor(vulnerability.Severity)"
                                                           Size="Size.Small">
                                                        @vulnerability.Severity
                                                    </MudChip>
                                                </div>
                                            </TitleContent>
                                            <ChildContent>
                                                <div class="vulnerability-details">
                                                    <MudText Typo="Typo.body2" Class="mb-2">@vulnerability.Description</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        CVE: @vulnerability.CveId | CVSS Score: @vulnerability.CvssScore
                                                    </MudText>
                                                </div>
                                            </ChildContent>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Success">
                                    <MudText>No known vulnerabilities found in this package or its dependencies.</MudText>
                                </MudAlert>
                            }
                        </section>

                        <!-- Security History -->
                        <section class="security-history-section">
                            <MudText Typo="Typo.h6" Class="mb-3">📈 Security Score History</MudText>
                            <AnalyticsChart Title="Security Score Trend"
                                           Subtitle="Security score over time"
                                           ChartType="Components.UI.Models.ChartType.Line"
                                           ChartSeries="@ChartSeriesConverter.ToMudBlazor(GetSecurityTrendData())"
                                           XAxisLabels="@GetSecurityTimeLabels()"
                                           ShowTimeRangeSelector="false"
                                           ShowDataTable="false"
                                           ShowSummary="false"
                                           Height="250" />
                        </section>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Versions" Icon="@Icons.Material.Filled.History">
                    <VersionComparison Versions="@GetVersionHistory()"
                                     OnInstallVersion="@((string version) => HandleInstallVersion(version))" />
                </MudTabPanel>

                <MudTabPanel Text="Versions (Old)" Icon="@Icons.Material.Filled.History" Style="display: none;">
                    <div class="versions-content">
                        <!-- Version History -->
                        <section class="version-history mb-6">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6">📦 Version History</MudText>
                                <MudButton Color="Color.Primary" 
                                         Variant="Variant.Outlined"
                                         StartIcon="@Icons.Material.Filled.Notifications"
                                         @onclick="SubscribeToUpdates">
                                    Subscribe to Updates
                                </MudButton>
                            </div>

                            <div class="version-list">
                                @foreach (var version in GetVersionHistory())
                                {
                                    <MudPaper Class="version-item pa-4 mb-3" Elevation="1">
                                        <div class="d-flex justify-space-between align-start">
                                            <div class="version-info flex-grow-1">
                                                <div class="d-flex align-center mb-2">
                                                    <MudText Typo="Typo.h6" Class="mr-3">v@version.Version</MudText>
                                                    @if (version.IsLatest)
                                                    {
                                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Latest</MudChip>
                                                    }
                                                    @if (version.IsPrerelease)
                                                    {
                                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-1">Pre-release</MudChip>
                                                    }
                                                </div>
                                                
                                                <MudText Typo="Typo.body2" Class="mb-2">@version.Description</MudText>
                                                
                                                <div class="version-metadata d-flex gap-4">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        Released @FormatLastUpdated(version.ReleaseDate)
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @FormatDownloads(version.Downloads) downloads
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        Security: @version.SecurityGrade
                                                    </MudText>
                                                </div>
                                            </div>
                                            
                                            <div class="version-actions">
                                                <MudButton Color="Color.Primary" 
                                                         Variant="Variant.Outlined"
                                                         Size="Size.Small"
                                                         @onclick="@(() => SelectVersion(version.Version))">
                                                    Select
                                                </MudButton>
                                            </div>
                                        </div>
                                        
                                        @if (version.Changes?.Any() == true)
                                        {
                                            <MudCollapse Expanded="false">
                                                <div class="version-changes mt-3">
                                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Changes in this version:</MudText>
                                                    <ul class="change-list">
                                                        @foreach (var change in version.Changes)
                                                        {
                                                            <li>
                                                                <MudText Typo="Typo.body2">@change</MudText>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </MudCollapse>
                                        }
                                    </MudPaper>
                                }
                            </div>
                        </section>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Dependencies" Icon="@Icons.Material.Filled.AccountTree">
                    <div class="dependencies-content">
                        <!-- Dependencies List -->
                        <section class="dependencies-section mb-6">
                            <MudText Typo="Typo.h6" Class="mb-3">🔗 Dependencies</MudText>
                            
                            @if (GetDependencies().Any())
                            {
                                <MudTable Items="@GetDependencies()" Hover="true" Striped="true">
                                    <HeaderContent>
                                        <MudTh>Package</MudTh>
                                        <MudTh>Version</MudTh>
                                        <MudTh>Security</MudTh>
                                        <MudTh>License</MudTh>
                                        <MudTh>Actions</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Package">
                                            <div class="d-flex align-center">
                                                <MudText>@context.Name</MudText>
                                                @if (context.IsOutdated)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" 
                                                           Color="Color.Warning" 
                                                           Size="Size.Small" 
                                                           Class="ml-2"
                                                           Title="Outdated version" />
                                                }
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="Version">@context.Version</MudTd>
                                        <MudTd DataLabel="Security">
                                            <SecurityGradeBadge Grade="@context.SecurityGrade" 
                                                              Score="@context.SecurityScore"
                                                              ShowScore="false" />
                                        </MudTd>
                                        <MudTd DataLabel="License">@context.License</MudTd>
                                        <MudTd DataLabel="Actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                         Color="Color.Primary"
                                                         Size="Size.Small"
                                                         @onclick="@(() => ViewDependency(context))"
                                                         Title="View dependency" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info">
                                    <MudText>This package has no external dependencies.</MudText>
                                </MudAlert>
                            }
                        </section>

                        <!-- Dependents -->
                        <section class="dependents-section">
                            <MudText Typo="Typo.h6" Class="mb-3">📊 Packages That Depend On This</MudText>
                            
                            @if (GetDependents().Any())
                            {
                                <MudGrid Spacing="3">
                                    @foreach (var dependent in GetDependents())
                                    {
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudCard Elevation="1">
                                                <MudCardContent>
                                                    <MudText Typo="Typo.h6" Class="mb-1">@dependent.Name</MudText>
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                                        @dependent.Description
                                                    </MudText>
                                                    <div class="d-flex justify-space-between align-center">
                                                        <MudText Typo="Typo.caption">@FormatDownloads(dependent.WeeklyDownloads)/week</MudText>
                                                        <MudButton Color="Color.Primary" 
                                                                 Variant="Variant.Text"
                                                                 Size="Size.Small"
