@using System.Text.RegularExpressions

<div class="password-strength-indicator mt-2">
    <div class="d-flex align-center gap-2 mb-2">
        <MudText Typo="Typo.caption" Class="flex-grow-1">
            Password Strength: <strong class="@GetStrengthColorClass()">@GetStrengthText()</strong>
        </MudText>
        <MudProgressLinear Value="@GetStrengthPercentage()" 
                          Color="@GetStrengthColor()" 
                          Size="Size.Small" 
                          Class="flex-grow-1" />
    </div>
    
    <div class="password-requirements">
        <MudGrid Spacing="1">
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@(HasMinLength ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(HasMinLength ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="@(HasMinLength ? Color.Success : Color.Error)">
                        At least 8 characters
                    </MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@(HasUppercase ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(HasUppercase ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="@(HasUppercase ? Color.Success : Color.Error)">
                        Uppercase letter
                    </MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@(HasLowercase ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(HasLowercase ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="@(HasLowercase ? Color.Success : Color.Error)">
                        Lowercase letter
                    </MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@(HasNumber ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(HasNumber ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="@(HasNumber ? Color.Success : Color.Error)">
                        Number
                    </MudText>
                </div>
            </MudItem>
            @if (HasSpecialChar)
            {
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Check"
                                 Color="Color.Success"
                                 Size="Size.Small" />
                        <MudText Typo="Typo.caption" Color="Color.Success">
                            Special character (bonus)
                        </MudText>
                    </div>
                </MudItem>
            }
        </MudGrid>
    </div>
</div>

@code {
    [Parameter] public string Password { get; set; } = string.Empty;

    private bool HasMinLength => Password.Length >= 8;
    private bool HasUppercase => Regex.IsMatch(Password, @"[A-Z]");
    private bool HasLowercase => Regex.IsMatch(Password, @"[a-z]");
    private bool HasNumber => Regex.IsMatch(Password, @"\d");
    private bool HasSpecialChar => Regex.IsMatch(Password, @"[^a-zA-Z0-9]");

    private int GetStrengthScore()
    {
        int score = 0;
        if (HasMinLength) score++;
        if (HasUppercase) score++;
        if (HasLowercase) score++;
        if (HasNumber) score++;
        if (HasSpecialChar) score++;
        return score;
    }

    private double GetStrengthPercentage() => (GetStrengthScore() / 5.0) * 100;

    private Color GetStrengthColor() => GetStrengthScore() switch
    {
        <= 2 => Color.Error,
        3 => Color.Warning,
        4 => Color.Info,
        5 => Color.Success,
        _ => Color.Default
    };

    private string GetStrengthColorClass() => GetStrengthScore() switch
    {
        <= 2 => "mud-error-text",
        3 => "mud-warning-text",
        4 => "mud-info-text",
        5 => "mud-success-text",
        _ => ""
    };

    private string GetStrengthText() => GetStrengthScore() switch
    {
        0 => "Enter password",
        1 => "Very Weak",
        2 => "Weak",
        3 => "Fair",
        4 => "Good",
        5 => "Strong",
        _ => ""
    };
}