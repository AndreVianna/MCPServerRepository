    private string FormatDownloads(long downloads)
    {
        return downloads switch
        {
            >= 1000000 => $"{downloads / 1000000.0:F1}M",
            >= 1000 => $"{downloads / 1000.0:F1}K",
            _ => downloads.ToString()
        };
    }

    private List<PackageInfo> ConvertApiResultsToPackageInfo(IEnumerable<PackageSearchResultItem> apiResults)
    {
        return apiResults.Select(item => new PackageInfo
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            LatestVersion = item.Version,
            Publisher = new PublisherInfo 
            { 
                Name = item.Publisher.ToLower().Replace(" ", "-"), 
                DisplayName = item.Publisher, 
                IsVerified = item.TrustTier != "unverified"
            },
            SecurityGrade = item.SecurityGrade,
            SecurityScore = CalculateSecurityScore(item.SecurityGrade),
            TrustTier = ConvertTrustTier(item.TrustTier),
            WeeklyDownloads = item.DownloadCount,
            Rating = item.Rating,
            RatingCount = item.RatingCount,
            Tags = item.Tags,
            Category = item.Category,
            License = item.License,
            IsFeatured = item.IsFeatured,
            IsTrending = item.IsTrending,
            LastUpdated = item.LastUpdated,
            CreatedAt = item.CreatedAt
        }).ToList();
    }

    private double CalculateSecurityScore(string securityGrade)
    {
        return securityGrade.ToUpper() switch
        {
            "A+" => 10.0,
            "A" => 9.0,
            "B+" => 8.5,
            "B" => 8.0,
            "C+" => 7.5,
            "C" => 7.0,
            "D" => 6.0,
            "F" => 4.0,
            _ => 5.0
        };
    }

    private TrustTier ConvertTrustTier(string trustTier)
    {
        return trustTier.ToLower() switch
        {
            "enterprise" => TrustTier.Enterprise,
            "trusted" => TrustTier.CommunityTrusted,
            "verified" => TrustTier.Verified,
            "unverified" => TrustTier.Unverified,
            _ => TrustTier.Unverified
        };
    }

