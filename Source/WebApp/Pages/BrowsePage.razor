    private List<PackageInfo> GenerateMockPackages(int count, bool trending = false, bool recentlyUpdated = false, string? category = null)
    {
        var random = new Random();
        var packages = new List<PackageInfo>();
        
        var baseNames = new[] { "ai-assistant", "data-processor", "web-scraper", "automation-bot", "security-scanner", "api-connector", "ml-toolkit", "file-manager", "chart-builder", "notification-service" };
        var publishers = new[]
        {
            new PublisherInfo { Name = "ai-innovations", DisplayName = "AI Innovations", IsVerified = true },
            new PublisherInfo { Name = "data-solutions", DisplayName = "Data Solutions Corp", IsVerified = true },
            new PublisherInfo { Name = "dev-tools", DisplayName = "DevTools Inc", IsVerified = false },
            new PublisherInfo { Name = "enterprise-tech", DisplayName = "Enterprise Tech", IsVerified = true }
        };

        for (int i = 0; i < count; i++)
        {
            var package = new PackageInfo
            {
                Name = $"{baseNames[i % baseNames.Length]}-{random.Next(1, 100)}",
                LatestVersion = $"{random.Next(1, 5)}.{random.Next(0, 10)}.{random.Next(0, 10)}",
                Description = $"Advanced {category ?? "tool"} with enhanced features and enterprise-grade security.",
                Publisher = publishers[random.Next(publishers.Length)],
                SecurityGrade = new[] { "A+", "A", "B+", "B" }[random.Next(4)],
                SecurityScore = random.NextDouble() * 2 + 8,
                TrustTier = (TrustTier)random.Next(4),
                WeeklyDownloads = random.Next(1000, 150000),
                Rating = random.NextDouble() * 2 + 3,
                LastUpdated = recentlyUpdated ? DateTime.UtcNow.AddDays(-random.Next(1, 7)) : DateTime.UtcNow.AddDays(-random.Next(1, 90)),
                Tags = GenerateRandomTags(random, category),
                IsTrending = trending || random.Next(10) < 2,
                IsStarred = false
            };

            packages.Add(package);
        }

        return packages;
    }

    private List<string> GenerateRandomTags(Random random, string? category = null)
    {
        var categoryTags = category switch
        {
            "ai" => new[] { "AI", "ML", "NLP", "Computer Vision", "Deep Learning" },
            "data" => new[] { "Data", "ETL", "Analytics", "Processing", "Pipeline" },
            "web" => new[] { "Web", "API", "Frontend", "Backend", "Framework" },
            "automation" => new[] { "Automation", "Workflow", "Scheduling", "Task" },
            "security" => new[] { "Security", "Privacy", "Compliance", "Scanning" },
            _ => new[] { "Tool", "Utility", "Framework", "Service", "Platform" }
        };

        var count = random.Next(2, 5);
        return categoryTags.OrderBy(x => random.Next()).Take(count).ToList();
    }

