@page "/login"
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Login - MCP Hub</PageTitle>

<MudContainer maxwidth="MaxWidth.Small" Class="mt-12">
    <MudPaper Elevation="2" Class="pa-8">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Security" 
                     Color="Color.Primary" 
                     Style="font-size: 3rem; margin-bottom: 1rem;" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">
                Sign In to MCP Hub
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                Access your secure package registry account
            </MudText>
        </div>

        <EditForm Model="@_loginModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            
            <MudGrid Spacing="4">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_loginModel.Email"
                                  Label="Email Address"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  For="@(() => _loginModel.Email)"
                                  fullwidth="true"
                                  Immediate="true" />
                </MudItem>
                
                <MudItem xs="12">
                    <MudTextField @bind-Value="_loginModel.Password"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                  Required="true"
                                  For="@(() => _loginModel.Password)"
                                  fullwidth="true"
                                  Immediate="true" />
                </MudItem>
                
                <MudItem xs="12">
                    <div class="d-flex justify-space-between align-center">
                        <MudCheckBox @bind-Value="_loginModel.RememberMe" Color="Color.Primary">
                            Remember me
                        </MudCheckBox>
                        
                        <MudLink Href="/forgot-password" Color="Color.Primary">
                            Forgot password?
                        </MudLink>
                    </div>
                </MudItem>
                
                <MudItem xs="12">
                    <MudButton ButtonType="ButtonType.Submit"
                              Variant="Variant.Filled"
                              Color="Color.Primary"
                              fullwidth="true"
                              Size="Size.Large"
                              Disabled="@_isLoading"
                              starticon="@(_isLoading ? null : Icons.Material.Filled.Login)">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Signing In...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </MudButton>
                </MudItem>
                
                <MudItem xs="12">
                    <SocialLoginButtons IsLoading="@_isSocialLoading" OnSocialLoginClick="@HandleSocialLogin" />
                </MudItem>
                
                <MudItem xs="12">
                    <MudDivider />
                    <div class="text-center mt-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Don't have an account?
                            <MudLink Href="/register" Color="Color.Primary" Class="font-weight-bold">
                                Create one here
                            </MudLink>
                        </MudText>
                    </div>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private LoginModel _loginModel = new();
    private bool _showPassword = false;
    private bool _isLoading = false;
    private bool _isSocialLoading = false;

    private async Task HandleLogin()
    {
        _isLoading = true;
        try
        {
            var request = new LoginRequest
            {
                Email = _loginModel.Email,
                Password = _loginModel.Password
            };

            var result = await AuthService.LoginAsync(request);
            
            if (result.IsSuccess)
            {
                Snackbar.Add("Login successful! Welcome back.", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                Snackbar.Add($"Login failed: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSocialLogin(string provider)
    {
        _isSocialLoading = true;
        try
        {
            // TODO: Implement actual social login
            Snackbar.Add($"{provider} login will be available soon!", Severity.Info);
            await Task.Delay(1000); // Simulate API call
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Social login error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSocialLoading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = false;
    }
}