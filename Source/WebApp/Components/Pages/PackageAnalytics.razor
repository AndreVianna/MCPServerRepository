    // Helper methods for data formatting and display
    private string FormatNumber(long number) => number switch
    {
        >= 1000000 => $"{number / 1000000.0:F1}M",
        >= 1000 => $"{number / 1000.0:F1}K",
        _ => number.ToString("N0")
    };

    private string FormatDuration(TimeSpan duration) => duration.TotalHours >= 1 
        ? $"{duration.TotalHours:F1}h" 
        : $"{duration.TotalMinutes:F0}m";

    private string FormatRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        return timeSpan.TotalDays switch
        {
            var days when days < 1 && timeSpan.TotalHours < 1 => $"{(int)timeSpan.TotalMinutes}m ago",
            var days when days < 1 => $"{(int)timeSpan.TotalHours}h ago",
            var days when days < 7 => $"{(int)timeSpan.TotalDays}d ago",
            _ => dateTime.ToString("MMM dd, yyyy")
        };
    }

    private Components.UI.Models.ChartType GetChartTypeForMetric() => _selectedMetric switch
    {
        "downloads" => Components.UI.Models.ChartType.Line,
        "users" => Components.UI.Models.ChartType.Bar,
        "versions" => Components.UI.Models.ChartType.Donut,
        _ => Components.UI.Models.ChartType.Line
    };

    private Color GetSecurityColor() => (_packageAnalytics?.Security.SecurityScore ?? 0) switch
    {
        var score when score >= 90 => Color.Success,
        var score when score >= 70 => Color.Warning,
        _ => Color.Error
    };

    private Color GetSuccessRateColor() => (_packageAnalytics?.Performance.SuccessRate ?? 0) switch
    {
        var rate when rate >= 95 => Color.Success,
        var rate when rate >= 85 => Color.Warning,
        _ => Color.Error
    };

    private Color GetDependencyHealthColor() => (_packageAnalytics?.Dependencies.DependencyHealth ?? 0) switch
    {
        var health when health >= 80 => Color.Success,
        var health when health >= 60 => Color.Warning,
        _ => Color.Error
    };

    private Color GetFeedbackTypeColor(string type) => type.ToLower() switch
    {
        "review" => Color.Success,
        "issue" => Color.Error,
        "suggestion" => Color.Info,
        _ => Color.Default
    };

    private List<Components.UI.Models.ChartSeries> GetDownloadChartSeries()
    {
        if (_packageAnalytics?.Downloads?.DownloadData == null) return new();

        return new List<Components.UI.Models.ChartSeries>
        {
            new() { Name = "Downloads", Data = _packageAnalytics.Downloads.DownloadData.Select(d => (double)d.DownloadCount).ToArray() }
        };
    }

    private string[] GetDownloadChartLabels()
    {
        if (_packageAnalytics?.Downloads?.DownloadData == null) return Array.Empty<string>();

        return _packageAnalytics.Downloads.DownloadData.Select(d => d.Label).ToArray();
    }

    private List<Components.UI.Models.ChartSeries> GetVersionChartSeries()
    {
        if (_packageAnalytics?.Versions?.VersionBreakdown == null) return new();

        return new List<Components.UI.Models.ChartSeries>
        {
            new() { 
                Name = "Version Adoption", 
                Data = _packageAnalytics.Versions.VersionBreakdown.Select(v => v.Percentage).ToArray() 
            }
        };
    }
