    // Helper methods for export data generation
    private List<Components.UI.Models.ChartSeries> GetDownloadTrendsSeries()
    {
        if (_globalStats?.Downloads?.TrendData == null) return new();

        return new List<Components.UI.Models.ChartSeries>
        {
            new() { Name = "Downloads", Data = _globalStats.Downloads.TrendData.Select(d => (double)d.Value).ToArray() }
        };
    }

    private string[] GetDownloadLabels()
    {
        if (_globalStats?.Downloads?.TrendData == null) return Array.Empty<string>();
        return _globalStats.Downloads.TrendData.Select(d => d.Label).ToArray();
    }

    private List<Components.UI.Models.ChartSeries> GetTechnologyStackSeries()
    {
        if (_technologyStack?.Technologies == null) return new();

        return new List<Components.UI.Models.ChartSeries>
        {
            new() { 
                Name = "Market Share", 
                Data = _technologyStack.Technologies.Values.Select(t => t.MarketShare).ToArray() 
            }
        };
    }

    private string[] GetTechnologyLabels()
    {
        if (_technologyStack?.Technologies == null) return Array.Empty<string>();
        return _technologyStack.Technologies.Keys.ToArray();
    }

    private string GetTimeRangeDisplayName(string timeRange) => timeRange switch
    {
        "7d" => "Last 7 days",
        "30d" => "Last 30 days",
        "90d" => "Last 3 months",
        "1y" => "Last year",
        "all" => "All time",
        _ => timeRange
    };

    // Helper methods for data formatting and display
    private string FormatNumber(long number) => number switch
    {
        >= 1000000 => $"{number / 1000000.0:F1}M",
        >= 1000 => $"{number / 1000.0:F1}K",
        _ => number.ToString("N0")
    };

    private double? GetMetricChange(string metric) => _globalStats?.Overview.MetricChanges.TryGetValue(metric, out var change) == true ? change : null;

    private Color GetSecurityScoreColor() => (_globalStats?.Overview.AverageSecurityScore ?? 0) switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Warning,
        _ => Color.Error
    };

    private Color GetHealthScoreColor() => (_ecosystemHealth?.OverallHealthScore ?? 0) switch
    {
        >= 85 => Color.Success,
        >= 70 => Color.Warning,
        _ => Color.Error
    };

    private Color GetHealthIndicatorColor(double value) => value switch
    {
        >= 85 => Color.Success,
        >= 70 => Color.Warning,
        _ => Color.Error
    };

    private Severity GetAlertSeverity(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => Severity.Error,
        AlertSeverity.High => Severity.Error,
        AlertSeverity.Medium => Severity.Warning,
        AlertSeverity.Low => Severity.Info,
        _ => Severity.Normal
    };

    private string GetCountryFlag(string countryCode) => countryCode switch
    {
        "US" => "🇺🇸",
        "CN" => "🇨🇳",
        "DE" => "🇩🇪",
        "IN" => "🇮🇳",
        "GB" => "🇬🇧",
        "JP" => "🇯🇵",
        "FR" => "🇫🇷",
        "CA" => "🇨🇦",
        "AU" => "🇦🇺",
        "BR" => "🇧🇷",
        _ => "🌍"
    };

