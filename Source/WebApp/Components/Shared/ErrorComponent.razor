@namespace MCPHub.WebApp.Components.Shared

<MudAlert Severity="@Severity" Variant="@Variant" Class="@Class">
    <div class="d-flex align-center">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <MudIcon Icon="@Icon" Class="mr-3" />
        }
        <div class="flex-grow-1">
            @if (!string.IsNullOrEmpty(Title))
            {
                <MudText Typo="Typo.h6" Class="mb-1">@Title</MudText>
            }
            @if (!string.IsNullOrEmpty(Message))
            {
                <MudText Typo="Typo.body2">@Message</MudText>
            }
            @if (ChildContent != null)
            {
                @ChildContent
            }
        </div>
    </div>
</MudAlert>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public Severity Severity { get; set; } = Severity.Error;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}