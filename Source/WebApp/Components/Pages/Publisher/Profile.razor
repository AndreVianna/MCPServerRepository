    // Data classes for mock data
    public enum VerificationStatus
    {
        NotStarted,
        Pending,
        Verified,
        Rejected
    }

    private PublisherProfile MapServiceProfileToComponentProfile(Services.PublisherProfile serviceProfile)
    {
        return new PublisherProfile
        {
            Id = serviceProfile.Id,
            DisplayName = serviceProfile.DisplayName,
            Username = serviceProfile.Name, // Map Name to Username
            Email = serviceProfile.Email,
            Bio = serviceProfile.Bio ?? string.Empty,
            Website = serviceProfile.Website ?? string.Empty,
            GitHubProfile = serviceProfile.SocialLinks?.FirstOrDefault(s => s.Platform == SocialPlatform.GitHub)?.Url ?? string.Empty,
            VerificationStatus = MapToVerificationStatus(serviceProfile.VerificationStatus.IsVerified),
            TrustTier = serviceProfile.TrustTier,
            TrustScore = CalculateTrustScore(serviceProfile.TrustTier),
            TotalPackages = serviceProfile.Statistics.TotalPackages,
            TotalDownloads = serviceProfile.Statistics.TotalDownloads,
            AverageRating = serviceProfile.Statistics.AverageRating,
            TwoFactorEnabled = false, // TODO: Get from security settings
            CreatedAt = serviceProfile.CreatedAt
        };
    }

    private IEnumerable<ApiKey> MapServiceApiKeysToComponentApiKeys(Services.ApiKeyInfo serviceApiKeys)
    {
        return serviceApiKeys.ApiKeys.Select(key => new ApiKey
        {
            Id = key.Id,
            Name = key.Name,
            CreatedAt = key.CreatedAt,
            LastUsed = key.LastUsed
        });
    }

    private VerificationStatus MapToVerificationStatus(bool isVerified)
    {
        return isVerified ? VerificationStatus.Verified : VerificationStatus.Pending;
    }

    private int CalculateTrustScore(TrustTier trustTier)
    {
        return trustTier switch
        {
            TrustTier.Enterprise => 900,
            TrustTier.CommunityTrusted => 750,
            TrustTier.Verified => 600,
            _ => 300
        };
    }

