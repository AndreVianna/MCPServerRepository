{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_64_CHARACTERS_LONG_FOR_PRODUCTION_USE_12345678901234567890",
    "Issuer": "MCPHub.PublicApi",
    "Audience": "MCPHub.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewMinutes": 5,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "RateLimiting": {
    "Enabled": true,
    "UseInMemory": true,
    "RedisConnectionString": null,
    "IpWhitelist": ["127.0.0.1", "::1"],
    "ExemptRoles": ["Admin", "System"],
    "Authentication": {
      "PermitLimit": 5,
      "WindowMinutes": 1,
      "QueueLimit": 0,
      "PerIpLimiting": true,
      "PerUserLimiting": false,
      "Strategy": "FixedWindow",
      "PolicyName": "Authentication"
    },
    "Search": {
      "PermitLimit": 100,
      "WindowMinutes": 1,
      "QueueLimit": 10,
      "PerIpLimiting": true,
      "PerUserLimiting": false,
      "Strategy": "FixedWindow",
      "PolicyName": "Search"
    },
    "PackageCrud": {
      "PermitLimit": 50,
      "WindowMinutes": 1,
      "QueueLimit": 5,
      "PerIpLimiting": false,
      "PerUserLimiting": true,
      "Strategy": "FixedWindow",
      "PolicyName": "PackageCrud"
    },
    "PublicRead": {
      "PermitLimit": 200,
      "WindowMinutes": 1,
      "QueueLimit": 20,
      "PerIpLimiting": true,
      "PerUserLimiting": false,
      "Strategy": "FixedWindow",
      "PolicyName": "PublicRead"
    },
    "Global": {
      "PermitLimit": 1000,
      "WindowMinutes": 1,
      "QueueLimit": 100,
      "PerIpLimiting": true,
      "PerUserLimiting": false,
      "Strategy": "FixedWindow",
      "PolicyName": "Global"
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123",
    "VirtualHost": "/",
    "ConnectionTimeout": 30,
    "RequestTimeout": 30,
    "HeartbeatInterval": 60,
    "EnablePublisherConfirms": true,
    "EnableMessagePersistence": true,
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3,
    "BaseRetryDelay": 5,
    "MaxRetryDelay": 300,
    "DeadLetterQueue": {
      "ExchangeName": "dlx",
      "QueueName": "dead-letters",
      "RoutingKey": "dead-letter",
      "Enabled": true,
      "MessageTtl": 86400000
    },
    "Exchanges": {
      "commands": {
        "Name": "commands",
        "Type": "topic",
        "Durable": true,
        "AutoDelete": false
      },
      "events": {
        "Name": "events",
        "Type": "topic",
        "Durable": true,
        "AutoDelete": false
      }
    },
    "Queues": {
      "server-events": {
        "Name": "server-events",
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false,
        "Exchange": "events",
        "RoutingKey": "server.*"
      }
    }
  }
}
