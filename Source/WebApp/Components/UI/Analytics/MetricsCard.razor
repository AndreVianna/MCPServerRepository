<MudCard Class="@GetCardClass()" Style="@GetCardStyle()" Elevation="@Elevation">
    <MudCardContent Class="pa-4">
        @if (IsLoading)
        {
            <div class="metrics-loading">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="24px" Width="60%" Class="mb-2" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="32px" Width="80%" Class="mb-2" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="16px" Width="50%" />
            </div>
        }
        else
        {
            <div class="metrics-content">
                <div class="metrics-header d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="metrics-title">
                        @Title
                    </MudText>
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <MudIcon Icon="@Icon" 
                                 Color="@Color" 
                                 Size="Size.Medium" 
                                 Class="metrics-icon" />
                    }
                </div>

                <div class="metrics-value mb-2">
                    <MudText Typo="Typo.h4" 
                             Color="@Color" 
                             Class="metrics-number">
                        @Value
                    </MudText>
                </div>

                @if (ShowTrend && TrendValue.HasValue)
                {
                    <div class="metrics-trend d-flex align-center">
                        <MudIcon Icon="@GetTrendIcon()" 
                                 Color="@GetTrendColor()" 
                                 Size="Size.Small" 
                                 Class="trend-icon mr-1" />
                        <MudText Typo="Typo.caption" 
                                 Color="@GetTrendColor()" 
                                 Class="trend-value">
                            @GetTrendText()
                        </MudText>
                        @if (!string.IsNullOrEmpty(TrendLabel))
                        {
                            <MudText Typo="Typo.caption" 
                                     Color="Color.Secondary" 
                                     Class="trend-label ml-1">
                                @TrendLabel
                            </MudText>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="Typo.caption" 
                             Color="Color.Secondary" 
                             Class="metrics-subtitle">
                        @Subtitle
                    </MudText>
                }

                @if (ShowProgressBar && Progress.HasValue)
                {
                    <MudProgressLinear Value="@Progress.Value" 
                                       Color="@Color" 
                                       Size="Size.Small"
                                       Class="mt-3" />
                }
            </div>
        }
    </MudCardContent>

    @if (IsClickable && OnClick.HasDelegate)
    {
        <MudCardActions Class="pa-2">
            <MudButton Size="Size.Small" 
                       Color="Color.Primary" 
                       Variant="Variant.Text"
                       fullwidth="true"
                       @onclick="HandleClick">
                @ClickText
            </MudButton>
        </MudCardActions>
    }
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool ShowTrend { get; set; } = true;
    [Parameter] public double? TrendValue { get; set; }
    [Parameter] public string? TrendLabel { get; set; }
    [Parameter] public bool ShowProgressBar { get; set; } = false;
    [Parameter] public double? Progress { get; set; }
    [Parameter] public bool IsClickable { get; set; } = false;
    [Parameter] public string ClickText { get; set; } = "View Details";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public int Elevation { get; set; } = 2;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;

    private string GetCardClass()
    {
        var classes = new List<string> { "metrics-card" };
        
        if (IsClickable)
            classes.Add("metrics-card-clickable");
        
        if (IsLoading)
            classes.Add("metrics-card-loading");
            
        if (!string.IsNullOrEmpty(Class))
            classes.Add(Class);
            
        return string.Join(" ", classes);
    }

    private string GetCardStyle()
    {
        var styles = new List<string>();
        
        if (IsClickable)
            styles.Add("cursor: pointer; transition: transform 0.2s ease-in-out;");
        
        if (!string.IsNullOrEmpty(Style))
            styles.Add(Style);
            
        return string.Join(" ", styles);
    }

    private string GetTrendIcon()
    {
        if (!TrendValue.HasValue) return Icons.Material.Filled.Remove;
        
        return TrendValue.Value switch
        {
            > 0 => Icons.Material.Filled.TrendingUp,
            < 0 => Icons.Material.Filled.TrendingDown,
            _ => Icons.Material.Filled.TrendingFlat
        };
    }

    private Color GetTrendColor()
    {
        if (!TrendValue.HasValue) return Color.Secondary;
        
        return TrendValue.Value switch
        {
            > 0 => Color.Success,
            < 0 => Color.Error,
            _ => Color.Secondary
        };
    }

    private string GetTrendText()
    {
        if (!TrendValue.HasValue) return "No change";
        
        var absValue = Math.Abs(TrendValue.Value);
        var sign = TrendValue.Value >= 0 ? "+" : "-";
        
        return $"{sign}{absValue:F1}%";
    }

    private async Task HandleClick()
    {
        if (IsClickable && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}

<style>
.metrics-card {
    height: 100%;
    border-radius: 12px;
    border: 1px solid var(--mud-palette-divider);
}

.metrics-card-clickable:hover {
    transform: translateY(-2px);
    box-shadow: var(--mud-elevation-8);
}

.metrics-card-loading {
    opacity: 0.7;
}

.metrics-content {
    min-height: 120px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.metrics-header {
    min-height: 24px;
}

.metrics-title {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.metrics-icon {
    opacity: 0.8;
}

.metrics-value {
    flex-grow: 1;
    display: flex;
    align-items: center;
}

.metrics-number {
    font-weight: 700;
    line-height: 1.2;
}

.metrics-trend {
    min-height: 20px;
}

.trend-icon {
    margin-right: 4px;
}

.trend-value {
    font-weight: 600;
}

.trend-label {
    font-style: italic;
}

.metrics-subtitle {
    line-height: 1.3;
}

/* Responsive adjustments */
@@media (max-width: 768px) {
    .metrics-card .mud-card-content {
        padding: 16px;
    }
    
    .metrics-number {
        font-size: 1.8rem;
    }
    
    .metrics-content {
        min-height: 100px;
    }
}

@@media (max-width: 480px) {
    .metrics-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .metrics-icon {
        align-self: flex-end;
    }
    
    .metrics-number {
        font-size: 1.6rem;
    }
}
</style>