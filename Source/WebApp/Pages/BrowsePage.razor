    private List<MudBlazor.ChartSeries> GetPackageGrowthData()
    {
        var random = new Random();
        var data = new double[12];
        var baseValue = 50;
        
        for (int i = 0; i < 12; i++)
        {
            baseValue += random.Next(-5, 15);
            data[i] = Math.Max(0, baseValue);
        }

        return new List<MudBlazor.ChartSeries>
        {
            new MudBlazor.ChartSeries { Name = "New Packages", Data = data }
        };
    }

    private string[] GetTimeLabels()
    {
        var labels = new string[12];
        var now = DateTime.Now;
        
        for (int i = 11; i >= 0; i--)
        {
            labels[11 - i] = now.AddMonths(-i).ToString("MMM");
        }
        
        return labels;
    }

