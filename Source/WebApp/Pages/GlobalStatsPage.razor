<style>
.global-stats-header {
    margin-bottom: 32px;
}

.header-title h3 {
    margin-bottom: 8px;
}

.overview-metrics,
.main-charts,
.secondary-charts,
.insights-section {
    width: 100%;
}

.analytics-chart-card {
    height: 100%;
    border-radius: 12px;
    border: 1px solid var(--mud-palette-divider);
}

.geographic-list {
    max-height: 320px;
    overflow-y: auto;
}

.country-item {
    padding: 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.country-item:hover {
    background-color: var(--mud-palette-action-hover);
}

.country-item.selected {
    background-color: var(--mud-palette-primary-lighten);
}

.category-performance-item {
    padding: 16px 24px;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.category-performance-item:hover {
    background-color: var(--mud-palette-action-hover);
}

.trending-packages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1px;
    background-color: var(--mud-palette-divider);
}

.trending-package-card {
    background-color: var(--mud-palette-surface);
    cursor: pointer;
    transition: all 0.2s ease;
}

.trending-package-card:hover {
    background-color: var(--mud-palette-action-hover);
    transform: translateY(-2px);
}

.ecosystem-health-score {
    padding: 16px;
    border: 2px solid var(--mud-palette-divider);
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(var(--mud-palette-success-rgb), 0.1), rgba(var(--mud-palette-info-rgb), 0.1));
}

.health-indicator {
    padding: 8px 0;
}

.health-indicator:last-child {
    padding-bottom: 0;
}

/* Mobile optimizations */
@@media (max-width: 768px) {
    .header-controls {
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
    }
    
    .time-range-selector,
    .export-controls {
        flex-direction: column;
        width: 100%;
    }
    
    .trending-packages-grid {
        grid-template-columns: 1fr;
    }
    
    .country-item,
    .category-performance-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .category-metrics,
    .country-stats {
        width: 100%;
        justify-content: space-between;
    }
}

/* Dark theme adjustments */
@@media (prefers-color-scheme: dark) {
    .trending-package-card {
        background-color: rgba(255, 255, 255, 0.02);
    }
    
    .ecosystem-health-score {
        background: linear-gradient(135deg, rgba(var(--mud-palette-success-rgb), 0.15), rgba(var(--mud-palette-info-rgb), 0.15));
    }
}

/* Accessibility enhancements */
.country-item:focus,
.category-performance-item:focus,
.trending-package-card:focus {
    outline: 2px solid var(--mud-palette-primary);
    outline-offset: 2px;
}

/* Animation for loading states */
.global-stats-loading {
    animation: fadeIn 0.3s ease-in-out;
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
</style>
