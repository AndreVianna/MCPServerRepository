@page "/analytics/global"
@inject IAnalyticsService AnalyticsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<GlobalStats> Logger
@inject NavigationManager Navigation

<PageTitle>Global Package Statistics - MCP Hub</PageTitle>

<ResponsiveContainer maxwidth="ContainerMaxWidth.ExtraLarge" FullHeight="true">
    <HeaderContent>
        <div class="global-stats-header">
            <div class="header-title mb-4">
                <MudText Typo="Typo.h3">🌍 Global Package Statistics</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    Platform-wide analytics and ecosystem insights
                </MudText>
            </div>

            <div class="header-controls d-flex justify-space-between align-center flex-wrap gap-3">
                <div class="time-range-selector d-flex align-center gap-3">
                    <MudSelect Value="@_selectedTimeRange"
                               Label="Time Range"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width: 150px;"
                               T="string"
                               ValueChanged="OnTimeRangeChanged">
                        <MudSelectItem Value="@("week")">Last 7 days</MudSelectItem>
                        <MudSelectItem Value="@("month")">Last 30 days</MudSelectItem>
                        <MudSelectItem Value="@("quarter")">Last 3 months</MudSelectItem>
                        <MudSelectItem Value="@("year")">Last year</MudSelectItem>
                        <MudSelectItem Value="@("all")">All time</MudSelectItem>
                    </MudSelect>

                    <MudSelect Value="@_selectedCategory"
                               Label="Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width: 180px;"
                               T="string"
                               Clearable="true"
                               ValueChanged="OnCategoryChanged">
                        <MudSelectItem Value="@("all")">All Categories</MudSelectItem>
                        @if (_categories?.Any() == true)
                        {
                            @foreach (var category in _categories)
                            {
                                <MudSelectItem Value="@category.Category">@category.Category (@category.PackageCount)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>

                <div class="export-controls d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               starticon="Icons.Material.Filled.Download"
                               Size="Size.Medium"
                               @onclick="ExportData">
                        Export Report
                    </MudButton>
                    
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               starticon="Icons.Material.Filled.Refresh"
                               Size="Size.Medium"
                               @onclick="RefreshData"
                               Disabled="_isLoading">
                        Refresh
                    </MudButton>
                </div>
            </div>
        </div>
    </HeaderContent>

    <MainContent>
        @if (_isLoading)
        {
            <div class="global-stats-loading">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudGrid Spacing="3">
                    <!-- Loading skeleton for overview metrics -->
                    @for (int i = 0; i < 6; i++)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" />
                        </MudItem>
                    }
                    <!-- Loading skeleton for charts -->
                    <MudItem xs="12" lg="8">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" />
                    </MudItem>
                    <MudItem xs="12" lg="4">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" />
                    </MudItem>
                </MudGrid>
            </div>
        }
        else
        {
            <!-- Global Overview Metrics -->
            <div class="overview-metrics mb-6">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <MetricsCard title="Total Packages"
                                     Value="@FormatNumber(_globalStats?.Overview.TotalPackages ?? 0)"
                                     Icon="Icons.Material.Filled.Inventory"
                                     Color="Color.Primary"
                                     ShowTrend="true"
                                     TrendValue="@GetMetricChange("packages")"
                                     TrendLabel="this period"
                                     IsClickable="true"
                                     ClickText="Browse Packages"
                                     OnClick="@(() => Navigation.NavigateTo("/browse"))" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <MetricsCard title="Total Downloads"
                                     Value="@FormatNumber(_globalStats?.Overview.TotalDownloads ?? 0)"
                                     Icon="Icons.Material.Filled.Download"
                                     Color="Color.Success"
                                     ShowTrend="true"
                                     TrendValue="@GetMetricChange("downloads")"
                                     TrendLabel="download growth"
                                     IsClickable="true"
                                     ClickText="View Trends"
                                     OnClick="@(() => ScrollToSection("download-trends"))" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <MetricsCard title="Active Publishers"
                                     Value="@FormatNumber(_globalStats?.Overview.ActivePublishers ?? 0)"
                                     Icon="Icons.Material.Filled.Business"
                                     Color="Color.Info"
                                     ShowTrend="true"
                                     TrendValue="@GetMetricChange("publishers")"
                                     TrendLabel="new publishers"
                                     IsClickable="true"
                                     ClickText="Publisher Stats"
                                     OnClick="@(() => ScrollToSection("publisher-insights"))" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <MetricsCard title="Countries Reached"
                                     Value="@(_globalStats?.Overview.CountriesReached.ToString() ?? "N/A")"
                                     Icon="Icons.Material.Filled.Public"
                                     Color="Color.Warning"
                                     ShowTrend="true"
                                     TrendValue="@GetMetricChange("countries")"
                                     TrendLabel="new countries"
                                     IsClickable="true"
                                     ClickText="Geographic View"
                                     OnClick="@(() => ScrollToSection("geographic-distribution"))" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <MetricsCard title="Avg Rating"
                                     Value="@(_globalStats?.Overview.AveragePackageRating.ToString("F1") ?? "N/A")"
                                     Icon="Icons.Material.Filled.Star"
                                     Color="Color.Tertiary"
                                     ShowProgressBar="true"
                                     Progress="@((_globalStats?.Overview.AveragePackageRating ?? 0) * 20)" 
                                     IsClickable="true"
                                     ClickText="Quality Metrics"
                                     OnClick="@(() => ScrollToSection("quality-metrics"))" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="2">
                        <MetricsCard title="Security Score"
                                     Value="@(_globalStats?.Overview.AverageSecurityScore.ToString("F0") ?? "N/A")"
                                     Icon="Icons.Material.Filled.Security"
                                     Color="@GetSecurityScoreColor()"
                                     ShowProgressBar="true"
                                     Progress="@_globalStats?.Overview.AverageSecurityScore"
                                     IsClickable="true"
                                     ClickText="Security Center"
                                     OnClick="@(() => ScrollToSection("security-overview"))" />
                    </MudItem>
                </MudGrid>
            </div>

            <!-- Main Analytics Charts -->
            <div class="main-charts mb-6">
                <MudGrid Spacing="3">
                    <!-- Download Trends Chart -->
                    <MudItem xs="12" lg="8" id="download-trends">
                        <AnalyticsChart title="🚀 Global Download Trends"
                                        Subtitle="Package downloads across the platform"
                                        ChartType="ChartTypeConverter.FromMudBlazor(MudBlazor.ChartType.Line)"
                                        ChartSeries="@GetDownloadTrendsChartSeries().ToMudBlazorChartSeries()"
                                        XAxisLabels="@GetDownloadTrendsLabels()"
                                        Height="400"
                                        ShowTimeRangeSelector="false"
                                        ShowSummary="true"
                                        EnableRealTime="true"
                                        EnableDrillDown="true"
                                        OnRefresh="RefreshDownloadTrends"
                                        OnDrillDown="HandleDownloadTrendsDrillDown"
                                        OnExport="ExportDownloadTrends" />
                    </MudItem>

                    <!-- Technology Stack Distribution -->
                    <MudItem xs="12" lg="4">
                        <AnalyticsChart title="⚡ Technology Stack"
                                        Subtitle="Popular technologies and frameworks"
                                        ChartType="ChartTypeConverter.FromMudBlazor(MudBlazor.ChartType.Donut)"
                                        ChartSeries="@GetTechnologyStackChartSeries().ToMudBlazorChartSeries()"
                                        Height="400"
                                        ShowTimeRangeSelector="false"
                                        ShowSummary="false"
                                        ShowDataTable="true"
                                        EnableDrillDown="true"
                                        OnDrillDown="HandleTechnologyDrillDown"
                                        OnExport="ExportTechnologyData" />
                    </MudItem>
                </MudGrid>
            </div>

            <!-- Secondary Analytics -->
            <div class="secondary-charts mb-6">
                <MudGrid Spacing="3">
                    <!-- Geographic Distribution -->
                    <MudItem xs="12" lg="6" id="geographic-distribution">
                        <MudCard Class="analytics-chart-card" Elevation="2">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">🌎 Geographic Distribution</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Package adoption by region
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-4">
                                <div class="geographic-chart" style="height: 350px;">
                                    @if (_globalStats?.Geographic?.TopCountries?.Any() == true)
                                    {
                                        <div class="geographic-list">
                                            @foreach (var country in _globalStats.Geographic.TopCountries.Take(10))
                                            {
                                                <div class="country-item d-flex justify-space-between align-center mb-3 @(_selectedCountry == country.CountryCode ? "selected" : "")"
                                                     @onclick="@(() => SelectCountry(country.CountryCode))"
                                                     role="button"
                                                     tabindex="0">
                                                    <div class="country-info d-flex align-center">
                                                        <span class="country-flag mr-2" style="font-size: 1.5em;">@GetCountryFlag(country.CountryCode)</span>
                                                        <div>
                                                            <MudText Typo="Typo.body2" Class="font-weight-bold">@country.CountryName</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @country.Percentage.ToString("F1")% of downloads • @country.UniqueUsers users
                                                            </MudText>
                                                        </div>
                                                    </div>
                                                    <div class="country-stats text-right">
                                                        <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                            @FormatNumber(country.Downloads)
                                                        </MudText>
                                                        <div class="d-flex align-center gap-2">
                                                            <MudProgressLinear Value="@country.Percentage" 
                                                                               Color="Color.Primary" 
                                                                               Size="Size.Small"
                                                                               Style="width: 60px;" />
                                                            @if (country.GrowthRate > 0)
                                                            {
                                                                <MudIcon Icon="Icons.Material.Filled.TrendingUp" 
                                                                         Color="Color.Success" 
                                                                         Size="Size.Small" />
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-data text-center pa-8">
                                            <MudIcon Icon="Icons.Material.Outlined.Map" Size="Size.Large" Color="Color.Secondary" />
                                            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                                                No geographic data available
                                            </MudText>
                                        </div>
                                    }
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <!-- Category Performance -->
                    <MudItem xs="12" lg="6">
                        <MudCard Class="analytics-chart-card" Elevation="2">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">📊 Category Performance</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Top performing package categories
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-0">
                                @if (_categories?.Any() == true)
                                {
                                    <MudList T="string">
                                        @foreach (var category in _categories.Take(8))
                                        {
                                            <MudListItem T="string" Class="category-performance-item"
                                                         @onclick="@(() => FilterByCategory(category.Category))"
                                                         Icon="@GetCategoryIcon(category.Category)">
                                                <div class="category-content d-flex justify-space-between align-center w-100">
                                                    <div class="category-info">
                                                        <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                            @category.Category
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @category.PackageCount packages • Avg rating: @category.AverageRating.ToString("F1")
                                                        </MudText>
                                                    </div>
                                                    <div class="category-metrics d-flex align-center gap-3">
                                                        <div class="metric text-center">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Downloads</MudText>
                                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                                @FormatNumber(category.TotalDownloads)
                                                            </MudText>
                                                        </div>
                                                        <div class="metric text-center">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Growth</MudText>
                                                            <MudText Typo="Typo.body2" 
                                                                     Class="font-weight-bold"
                                                                     Color="@(category.GrowthRate >= 0 ? Color.Success : Color.Error)">
                                                                @category.GrowthRate.ToString("+0.0%;-0.0%")
                                                            </MudText>
                                                        </div>
                                                        <MudIconButton Icon="Icons.Material.Filled.ArrowForward"
                                                                       Size="Size.Small"
                                                                       Color="Color.Primary" />
                                                    </div>
                                                </div>
                                            </MudListItem>
                                            @if (category != _categories.Last())
                                            {
                                                <MudDivider />
                                            }
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <div class="no-data text-center pa-8">
                                        <MudIcon Icon="Icons.Material.Outlined.Category" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                                            No category data available
                                        </MudText>
                                    </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </div>

            <!-- Trending Packages and Ecosystem Health -->
            <div class="insights-section mb-6">
                <MudGrid Spacing="3">
                    <!-- Trending Packages -->
                    <MudItem xs="12" lg="8">
                        <MudCard Class="analytics-chart-card" Elevation="2">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.h6">🔥 Trending Packages</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Fastest growing packages this period
                                            </MudText>
                                        </div>
                                        <MudButton Variant="Variant.Text" 
                                                   Color="Color.Primary" 
                                                   EndIcon="Icons.Material.Filled.ArrowForward"
                                                   @onclick="@(() => Navigation.NavigateTo("/trending"))">
                                            View All
                                        </MudButton>
                                    </div>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-0">
                                @if (_globalStats?.TrendingPackages?.Any() == true)
                                {
                                    <div class="trending-packages-grid">
                                        @foreach (var package in _globalStats.TrendingPackages.Take(6))
                                        {
                                            <div class="trending-package-card pa-4"
                                                 @onclick="@(() => Navigation.NavigateTo($"/package/{package.PackageId}"))"
                                                 role="button"
                                                 tabindex="0">
                                                <div class="d-flex justify-space-between align-center mb-2">
                                                    <MudText Typo="Typo.body1" Class="font-weight-bold">@package.Name</MudText>
                                                    <MudChip T="string" Text="@package.GrowthPercentage.ToString("+0.0%")" 
                                                             Color="Color.Success" 
                                                             Size="Size.Small" />
                                                </div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                                    @package.Description?.Truncate(100)
                                                </MudText>
                                                <div class="d-flex justify-space-between align-center">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudText Typo="Typo.caption">@FormatNumber(package.Downloads) downloads</MudText>
                                                        <MudRating ReadOnly="true" 
                                                                   SelectedValue="@((int)package.Rating)" 
                                                                   MaxValue="5" 
                                                                   Size="Size.Small" />
                                                    </div>
                                                    <div class="d-flex align-center gap-1">
                                                        <SecurityGradeBadge Grade="@package.SecurityGrade" Size="Size.Small" />
                                                        <TrustTierIndicator Tier="@package.TrustTier" Size="Size.Small" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="no-data text-center pa-8">
                                        <MudIcon Icon="Icons.Material.Outlined.TrendingUp" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                                            No trending packages data available
                                        </MudText>
                                    </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <!-- Ecosystem Health -->
                    <MudItem xs="12" lg="4" id="ecosystem-health">
                        <MudCard Class="analytics-chart-card" Elevation="2">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">🌱 Ecosystem Health</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Overall platform health indicators
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-4">
                                @if (_ecosystemHealth != null)
                                {
                                    <div class="ecosystem-health-score text-center mb-4">
                                        <MudText Typo="Typo.h4" Color="@GetHealthScoreColor()">
                                            @_ecosystemHealth.OverallHealthScore.ToString("F0")%
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Overall Health Score
                                        </MudText>
                                    </div>

                                    <div class="health-indicators">
                                        <div class="health-indicator mb-3">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2">Security</MudText>
                                                <MudText Typo="Typo.caption">@_ecosystemHealth.Indicators.SecurityHealth.ToString("F0")%</MudText>
                                            </div>
                                            <MudProgressLinear Value="@_ecosystemHealth.Indicators.SecurityHealth" 
                                                               Color="@GetHealthIndicatorColor(_ecosystemHealth.Indicators.SecurityHealth)" />
                                        </div>

                                        <div class="health-indicator mb-3">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2">Quality</MudText>
                                                <MudText Typo="Typo.caption">@_ecosystemHealth.Indicators.QualityHealth.ToString("F0")%</MudText>
                                            </div>
                                            <MudProgressLinear Value="@_ecosystemHealth.Indicators.QualityHealth" 
                                                               Color="@GetHealthIndicatorColor(_ecosystemHealth.Indicators.QualityHealth)" />
                                        </div>

                                        <div class="health-indicator mb-3">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2">Diversity</MudText>
                                                <MudText Typo="Typo.caption">@_ecosystemHealth.Indicators.DiversityHealth.ToString("F0")%</MudText>
                                            </div>
                                            <MudProgressLinear Value="@_ecosystemHealth.Indicators.DiversityHealth" 
                                                               Color="@GetHealthIndicatorColor(_ecosystemHealth.Indicators.DiversityHealth)" />
                                        </div>

                                        <div class="health-indicator mb-3">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2">Activity</MudText>
                                                <MudText Typo="Typo.caption">@_ecosystemHealth.Indicators.ActivityHealth.ToString("F0")%</MudText>
                                            </div>
                                            <MudProgressLinear Value="@_ecosystemHealth.Indicators.ActivityHealth" 
                                                               Color="@GetHealthIndicatorColor(_ecosystemHealth.Indicators.ActivityHealth)" />
                                        </div>

                                        <div class="health-indicator mb-3">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2">Community</MudText>
                                                <MudText Typo="Typo.caption">@_ecosystemHealth.Indicators.CommunityHealth.ToString("F0")%</MudText>
                                            </div>
                                            <MudProgressLinear Value="@_ecosystemHealth.Indicators.CommunityHealth" 
                                                               Color="@GetHealthIndicatorColor(_ecosystemHealth.Indicators.CommunityHealth)" />
                                        </div>

                                        <div class="health-indicator">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2">Innovation</MudText>
                                                <MudText Typo="Typo.caption">@_ecosystemHealth.Indicators.InnovationHealth.ToString("F0")%</MudText>
                                            </div>
                                            <MudProgressLinear Value="@_ecosystemHealth.Indicators.InnovationHealth" 
                                                               Color="@GetHealthIndicatorColor(_ecosystemHealth.Indicators.InnovationHealth)" />
                                        </div>
                                    </div>

                                    @if (_ecosystemHealth.Alerts?.Any() == true)
                                    {
                                        <MudDivider Class="my-4" />
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Health Alerts</MudText>
                                        @foreach (var alert in _ecosystemHealth.Alerts.Take(3))
                                        {
                                            <MudAlert Severity="@GetAlertSeverity(alert.Severity)" 
                                                      dense="true" 
                                                      Class="mb-2">
                                                <strong>@alert.Title:</strong> @alert.Description
                                            </MudAlert>
                                        }
                                    }
                                }
                                else
                                {
                                    <div class="no-data text-center pa-4">
                                        <MudIcon Icon="Icons.Material.Outlined.HealthAndSafety" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                                            Health data loading...
                                        </MudText>
                                    </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </div>
        }
    </MainContent>
</ResponsiveContainer>

@code {
    private bool _isLoading = true;
    private string _selectedTimeRange = "30d";
    private string _selectedCategory = "";
    private string _selectedCountry = "";

    private GlobalPlatformStatistics? _globalStats;
    private IEnumerable<CategoryStatistics>? _categories;
    private TechnologyStackAnalysis? _technologyStack;
    private EcosystemHealthMetrics? _ecosystemHealth;
    private List<PackageInfo>? _trendingPackages = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGlobalStatistics();
    }

    private async Task LoadGlobalStatistics()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            // Load global statistics
            _globalStats = await AnalyticsService.GetGlobalStatisticsAsync(_selectedTimeRange);
            _categories = _globalStats?.Categories;

            // Load additional data
            _technologyStack = await AnalyticsService.GetTechnologyStackAnalysisAsync(_selectedTimeRange);
            _ecosystemHealth = await AnalyticsService.GetEcosystemHealthAsync();
        }
        catch (NotImplementedException)
        {
            // Generate mock data for development
            GenerateMockGlobalData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading global statistics");
            Snackbar.Add("Failed to load global statistics", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void GenerateMockGlobalData()
    {
        var random = new Random();
        
        _globalStats = new GlobalPlatformStatistics
        {
            TimeRange = _selectedTimeRange,
            Overview = new GlobalOverviewMetrics
            {
                TotalPackages = 15847,
                TotalDownloads = 42891567,
                ActivePublishers = 3249,
                TotalUsers = 89432,
                AveragePackageRating = 4.3,
                AverageSecurityScore = 87.5,
                CountriesReached = 142,
                GrowthRate = 23.4,
                MetricChanges = new Dictionary<string, long>
                {
                    ["packages"] = 1234,
                    ["downloads"] = 8945672,
                    ["publishers"] = 234,
                    ["countries"] = 8
                }
            },
            Geographic = new GlobalGeographicDistribution
            {
                TotalCountries = 142,
                TopCountries = new[]
                {
                    new CountryAnalytics { CountryCode = "US", CountryName = "United States", Downloads = 15892345, Percentage = 37.1, GrowthRate = 15.2, UniqueUsers = 28934 },
