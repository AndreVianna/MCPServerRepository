                    IsVerified = true
                },
                SecurityGrade = "A",
                SecurityScore = 9.3,
                TrustTier = TrustTier.CommunityTrusted,
                WeeklyDownloads = 89000,
                Rating = 4.7,
                LastUpdated = DateTime.UtcNow.AddDays(-5),
                Tags = new List<string> { "Data", "ETL", "Analytics", "Streaming" },
                IsTrending = false,
                IsStarred = false,
                IsFeatured = true
            },
            new()
            {
                Name = "web-automation-suite",
                LatestVersion = "3.0.1",
                Description = "Complete web automation framework with browser control, form handling, data extraction, and testing capabilities.",
                Publisher = new PublisherInfo 
                { 
                    Name = "automation-experts",
                    DisplayName = "Automation Experts Inc",
                    Type = PublisherType.Organization,
                    IsVerified = true
                },
                SecurityGrade = "A",
                SecurityScore = 9.1,
                TrustTier = TrustTier.Verified,
                WeeklyDownloads = 67000,
                Rating = 4.6,
                LastUpdated = DateTime.UtcNow.AddDays(-3),
                Tags = new List<string> { "Automation", "Web", "Testing", "Scraping" },
                IsTrending = true,
                IsStarred = false,
                IsFeatured = true
            }
        };
    }

    // Demo event handlers
    private async Task HandleDemoSearch(SearchQuery query)
    {
        // For demo purposes, navigate to search page with query
        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(query.Text)}");
        await Task.CompletedTask;
    }

    private async Task HandleDemoInstall(PackageInfo package)
    {
        // For demo purposes, show a snackbar
        await Task.CompletedTask;
    }

    private async Task HandleDemoDetails(PackageInfo package)
    {
        // For demo purposes, navigate to package details
        Navigation.NavigateTo($"/package/{package.Publisher.Name}/{package.Name}");
        await Task.CompletedTask;
    }

    private async Task HandleDemoStar(PackageInfo package)
    {
        // For demo purposes, toggle star state
        package.IsStarred = !package.IsStarred;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task HandleDemoShare(PackageInfo package)
    {
        // For demo purposes
        await Task.CompletedTask;
    }

    private async Task HandleDemoMore(PackageInfo package)
    {
        // For demo purposes
        await Task.CompletedTask;
    }

    private async Task HandleDemoTagClick(string tag)
    {
        // For demo purposes, navigate to search with tag filter
        Navigation.NavigateTo($"/search?tag={Uri.EscapeDataString(tag)}");
        await Task.CompletedTask;
    }

    private async Task ShowDemoSecurityDetail()
    {
        // For demo purposes
        await Task.CompletedTask;
    }

    private async Task ShowDemoTrustDetail()
    {
        // For demo purposes
        await Task.CompletedTask;
    }
}
