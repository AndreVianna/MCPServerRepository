    private string GetInstallCommand()
    {
        var versionPart = string.IsNullOrEmpty(_selectedVersion) ? "" : $"@{_selectedVersion}";
        return $"mcpm install {PublisherName}/{PackageName}{versionPart}";
    }

    private string GetDockerCommand()
    {
        var versionPart = string.IsNullOrEmpty(_selectedVersion) ? "latest" : _selectedVersion;
        return $"docker run mcphub/{PublisherName}-{PackageName}:{versionPart}";
    }

    private string FormatDownloads(long downloads)
    {
        return downloads switch
        {
            var d when d >= 1000000 => $"{downloads / 1000000.0:F1}M",
            var d when d >= 1000 => $"{downloads / 1000.0:F1}K",
            _ => downloads.ToString()
        };
    }

    private string FormatLastUpdated(DateTime lastUpdated)
    {
        var timeSpan = DateTime.UtcNow - lastUpdated;
        return timeSpan.TotalDays switch
        {
            var days when days < 1 => "today",
            var days when days < 2 => "yesterday",
            var days when days < 7 => $"{(int)timeSpan.TotalDays} days ago",
            var days when days < 30 => $"{(int)(timeSpan.TotalDays / 7)} weeks ago",
            var days when days < 365 => $"{(int)(timeSpan.TotalDays / 30)} months ago",
            _ => $"{(int)(timeSpan.TotalDays / 365)} years ago"
        };
    }

