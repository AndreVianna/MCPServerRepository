    private async Task ExportData()
    {
        if (_globalStats == null)
        {
            Snackbar.Add("No data available for export", Severity.Warning);
            return;
        }

        try
        {
            var exportData = new ExportAnalyticsData
            {
                Title = "Global Package Statistics",
                Description = $"Platform-wide analytics for {_selectedTimeRange} time range" + 
                             (!string.IsNullOrEmpty(_selectedCategory) ? $" (Category: {_selectedCategory})" : ""),
                TimeRange = GetTimeRangeDisplayName(_selectedTimeRange),
                GeneratedAt = DateTime.UtcNow,
                Summary = new List<SummaryStat>
                {
                    new() { Label = "Total Packages", Value = FormatNumber(_globalStats.Overview.TotalPackages), Change = GetMetricChange("packages") },
                    new() { Label = "Total Downloads", Value = FormatNumber(_globalStats.Overview.TotalDownloads), Change = GetMetricChange("downloads") },
                    new() { Label = "Active Publishers", Value = FormatNumber(_globalStats.Overview.ActivePublishers), Change = GetMetricChange("publishers") },
                    new() { Label = "New Packages This Period", Value = FormatNumber(_globalStats.Overview.NewPackages), Change = GetMetricChange("new_packages") },
                    new() { Label = "Package Updates", Value = FormatNumber(_globalStats.Overview.PackageUpdates), Change = GetMetricChange("updates") },
                    new() { Label = "Growth Rate", Value = $"{_globalStats.Overview.GrowthRate:F1}%", Change = GetMetricChange("growth") }
                },
                Charts = new List<ExportChartData>
                {
                    new()
                    {
                        Title = "Download Trends Over Time",
                        Description = "Package download trends for the selected time period",
                        ChartType = Components.UI.Models.ChartType.Line,
                        Series = GetDownloadTrendsSeries(),
                        XAxisLabels = GetDownloadLabels()
                    },
                    new()
                    {
                        Title = "Technology Stack Distribution",
                        Description = "Distribution of packages by technology stack",
                        ChartType = Components.UI.Models.ChartType.Donut,
                        Series = GetTechnologyStackSeries(),
                        XAxisLabels = GetTechnologyLabels()
                    }
                },
                Tables = new Dictionary<string, List<Dictionary<string, object>>>
                {
                    ["CategoryBreakdown"] = _categories?.Select(c => new Dictionary<string, object>
                    {
                        ["Category"] = c.Category,
                        ["Package Count"] = c.PackageCount,
                        ["Total Downloads"] = c.TotalDownloads,
                        ["Avg Rating"] = c.AverageRating,
                        ["Growth Rate"] = c.GrowthRate
                    }).ToList() ?? new(),
                    ["TrendingPackages"] = _trendingPackages?.Select(p => new Dictionary<string, object>
                    {
                        ["Package Name"] = p.Name,
                        ["Downloads"] = p.WeeklyDownloads,
                        ["Rating"] = p.Rating,
                        ["Trust Tier"] = p.TrustTier.ToString(),
                        ["Security Grade"] = p.SecurityGrade
                    }).ToList() ?? new()
                },
                RawData = new Dictionary<string, object>
                {
                    ["ExportMetadata"] = new
                    {
                        ExportedBy = "MCP Hub Analytics",
                        Version = "1.0",
                        TimeRange = _selectedTimeRange,
                        Category = _selectedCategory ?? "All",
                        TotalRecords = _globalStats.Overview.TotalPackages
                    }
                }
            };

            var dialog = await DialogService.ShowExportDialogAsync(exportData, "global_package_statistics");
            var result = await dialog.Result;
            
            if (!result!.Canceled)
            {
                Logger.LogInformation("Global statistics exported successfully");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error preparing export data");
            Snackbar.Add("Failed to prepare export data", Severity.Error);
        }
    }

