{
  "$schema": "https://schemas.reqnroll.net/reqnroll-config-latest.json",
  "language": {
    "feature": "en"
  },
  "bindingCulture": {
    "name": "en-US"
  },
  "unitTestProvider": {
    "name": "xUnit"
  },
  "trace": {
    "traceSuccessfulSteps": true,
    "traceTimings": true,
    "minTracedDuration": "0:00:00.1",
    "stepDefinitionSkeletonStyle": "CucumberExpressionAttribute"
  },
  "bindingAssemblies": [
    {
      "assembly": "MCPHub.IntegrationTests"
    }
  ]
}
