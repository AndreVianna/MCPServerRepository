    private string GetApiSortField(string uiSortOption)
    {
        return uiSortOption switch
        {
            "trending" => "downloads",
            "downloads" => "downloads",
            "rating" => "rating",
            "updated" => "created",
            "security" => "name", // API doesn't support security score sorting yet
            "name" => "name",
            _ => "downloads"
        };
    }

    private string GetApiSortDirection(string uiSortOption)
    {
        return uiSortOption switch
        {
            "name" => "ascending",
            _ => "descending"
        };
    }

    private List<PackageInfo> ConvertApiResultsToPackageInfo(IEnumerable<PackageSearchResultItem> apiResults)
    {
        return apiResults.Select(item => new PackageInfo
        {
            Id = item.Id,
            Name = item.Name,
            LatestVersion = item.Version,
            Description = item.Description,
            Publisher = new PublisherInfo { Name = item.Publisher },
            Version = item.Version,
            LastUpdated = item.LastUpdated,
            WeeklyDownloads = item.DownloadCount,
            SecurityGrade = item.SecurityGrade,
            TrustTier = Enum.TryParse<TrustTier>(item.TrustTier, out var trustTier) ? trustTier : TrustTier.Unverified,
            Tags = item.Tags,
            Category = item.Category,
            License = item.License,
            IsFeatured = item.IsFeatured,
            IsTrending = item.IsTrending,
            Rating = item.Rating,
            RatingCount = item.RatingCount,
            CreatedAt = item.CreatedAt,
            SecurityScore = CalculateSecurityScore(item.SecurityGrade),
            TrustScore = CalculateTrustScore(item.TrustTier),
            AIRelevanceScore = null // API doesn't provide this yet
        }).ToList();
    }

    private double CalculateSecurityScore(string securityGrade)
    {
        return securityGrade.ToUpper() switch
        {
            "A+" => 100,
            "A" => 90,
            "B+" => 85,
            "B" => 80,
            "C+" => 75,
            "C" => 70,
            "D" => 60,
            "F" => 40,
            _ => 50
        };
    }

    private double CalculateTrustScore(string trustTier)
    {
        return trustTier.ToLower() switch
        {
            "enterprise" => 100,
            "trusted" => 85,
            "verified" => 70,
            "unverified" => 40,
            _ => 40
        };
    }

