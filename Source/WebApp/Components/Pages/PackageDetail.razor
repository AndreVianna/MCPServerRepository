                     StartIcon="@Icons.Material.Filled.Search"
                     @onclick="@(() => Navigation.NavigateTo("/search"))">
                Search Packages
            </MudButton>
        </div>
    </div>
}

@code {
    [Parameter] public string PublisherName { get; set; } = "";
    [Parameter] public string PackageName { get; set; } = "";
    [Parameter] public string? Version { get; set; }

    private PackageInfo? _package;
    private bool _isLoading = true;
    private string? _selectedVersion;

    protected override async Task OnInitializedAsync()
    {
        await LoadPackageDetails();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_package?.Name != PackageName || _package?.Publisher.Name != PublisherName)
        {
            await LoadPackageDetails();
        }
    }

    private async Task LoadPackageDetails()
    {
        _isLoading = true;
        
        try
        {
            // Call the real API to get package details
            var result = await ApiClient.GetPackageByNameAsync(PublisherName ?? "", PackageName ?? "", Version);
            
            if (result.IsSuccess && result.Package != null)
            {
                _package = ConvertApiPackageDetailsToPackageInfo(result.Package);
                _selectedVersion = Version ?? _package?.LatestVersion;
            }
            else
            {
                // Package not found or error, show 404 or fallback to mock data
                Console.WriteLine($"Package not found: {PublisherName}/{PackageName}");
                _package = GenerateMockPackageDetails();
                _selectedVersion = Version ?? _package?.LatestVersion;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading package details: {ex.Message}");
            // Fallback to mock data
            _package = GenerateMockPackageDetails();
            _selectedVersion = Version ?? _package?.LatestVersion;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // Event Handlers
    private async Task InstallPackage()
    {
        // Implementation for package installation
        await Task.CompletedTask;
    }

    private async Task ToggleStar()
    {
        if (_package != null)
