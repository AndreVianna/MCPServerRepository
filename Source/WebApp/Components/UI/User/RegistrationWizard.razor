@using MCPHub.Domain.Contracts.Requests
@using System.ComponentModel.DataAnnotations
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-8">
        <!-- Header -->
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" 
                     Color="Color.Primary" 
                     Style="font-size: 3rem; margin-bottom: 1rem;" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">
                Create Your MCP Hub Account
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                Join the secure MCP server registry community
            </MudText>
        </div>

        <!-- Progress Stepper -->
        <MudStepper @ref="_stepper" HeaderSize="Size.Large" HeaderBadgeView="BadgeView.All" 
                   NonLinear="false" PreventStepChangeAsync="OnStepChangeAsync">
            
            <!-- Step 1: Account Type Selection -->
            <MudStep Title="Account Type" Icon="@Icons.Material.Filled.AccountBox">
                <ChildContent>
                    <div class="d-flex flex-column align-center">
                        <MudText Typo="Typo.h6" Class="mb-4">Choose your account type</MudText>
                        <MudGrid Spacing="4" MaxWidth="600px">
                            <MudItem xs="12" md="4">
                                <MudCard Outlined="true" Class="@GetCardClass("Individual")" 
                                        Style="cursor: pointer; height: 200px;" 
                                        @onclick="@(() => SelectAccountType("Individual"))">
                                    <MudCardContent Class="d-flex flex-column align-center justify-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Class="mt-2">Individual</MudText>
                                        <MudText Typo="Typo.body2" Class="text-center mt-1">
                                            Personal projects and open source development
                                        </MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Outlined="true" Class="@GetCardClass("Organization")" 
                                        Style="cursor: pointer; height: 200px;" 
                                        @onclick="@(() => SelectAccountType("Organization"))">
                                    <MudCardContent Class="d-flex flex-column align-center justify-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Class="mt-2">Organization</MudText>
                                        <MudText Typo="Typo.body2" Class="text-center mt-1">
                                            Team collaboration and business use
                                        </MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Outlined="true" Class="@GetCardClass("Enterprise")" 
                                        Style="cursor: pointer; height: 200px;" 
                                        @onclick="@(() => SelectAccountType("Enterprise"))">
                                    <MudCardContent Class="d-flex flex-column align-center justify-center">
                                        <MudIcon Icon="@Icons.Material.Filled.CorporateFare" Size="Size.Large" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Class="mt-2">Enterprise</MudText>
                                        <MudText Typo="Typo.body2" Class="text-center mt-1">
                                            Large scale deployment and advanced features
                                        </MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                        
                        @if (!string.IsNullOrEmpty(_selectedAccountType))
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-4 max-width-600">
                                <strong>@_selectedAccountType Account:</strong> @GetAccountTypeDescription(_selectedAccountType)
                            </MudAlert>
                        }
                    </div>
                </ChildContent>
            </MudStep>

            <!-- Step 2: Basic Information -->
            <MudStep Title="Basic Information" Icon="@Icons.Material.Filled.Info">
                <ChildContent>
                    <EditForm Model="@_registrationModel" OnValidSubmit="@(() => Task.CompletedTask)">
                        <DataAnnotationsValidator />
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_registrationModel.FirstName"
                                              Label="First Name"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              For="@(() => _registrationModel.FirstName)"
                                              FullWidth="true"
                                              Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_registrationModel.LastName"
                                              Label="Last Name"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              For="@(() => _registrationModel.LastName)"
                                              FullWidth="true"
                                              Immediate="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_registrationModel.Email"
                                              Label="Email Address"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Email"
                                              Required="true"
                                              For="@(() => _registrationModel.Email)"
                                              FullWidth="true"
                                              HelperText="This will be your login email and where we send important security notifications"
                                              Immediate="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_registrationModel.Username"
                                              Label="Username"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              For="@(() => _registrationModel.Username)"
                                              FullWidth="true"
                                              HelperText="This will be your public profile name (can be changed later)"
                                              Immediate="true" />
                            </MudItem>
                            @if (_selectedAccountType == "Organization" || _selectedAccountType == "Enterprise")
                            {
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_registrationModel.OrganizationName"
                                                  Label="Organization/Company Name"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  FullWidth="true"
                                                  Immediate="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_registrationModel.Website"
                                                  Label="Website (Optional)"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Url"
                                                  FullWidth="true"
                                                  Immediate="true" />
                                </MudItem>
                            }
                        </MudGrid>
                    </EditForm>
                </ChildContent>
            </MudStep>

            <!-- Step 3: Security -->
            <MudStep Title="Security" Icon="@Icons.Material.Filled.Security">
                <ChildContent>
                    <EditForm Model="@_registrationModel" OnValidSubmit="@(() => Task.CompletedTask)">
                        <DataAnnotationsValidator />
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_registrationModel.Password"
                                              Label="Password"
                                              Variant="Variant.Outlined"
                                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                              Required="true"
                                              For="@(() => _registrationModel.Password)"
                                              FullWidth="true"
                                              Immediate="true" />
                                <PasswordStrengthIndicator Password="@_registrationModel.Password" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_registrationModel.ConfirmPassword"
                                              Label="Confirm Password"
                                              Variant="Variant.Outlined"
                                              InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)"
                                              Required="true"
                                              For="@(() => _registrationModel.ConfirmPassword)"
                                              FullWidth="true"
                                              Immediate="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_registrationModel.PhoneNumber"
                                              Label="Phone Number (Optional)"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Telephone"
                                              FullWidth="true"
                                              HelperText="For account recovery and optional SMS notifications"
                                              Immediate="true" />
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </ChildContent>
            </MudStep>

            <!-- Step 4: Terms and Preferences -->
            <MudStep Title="Terms & Preferences" Icon="@Icons.Material.Filled.Assignment">
                <ChildContent>
                    <MudGrid Spacing="4">
                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="_registrationModel.AcceptTerms" 
                                        Color="Color.Primary"
                                        Required="true"
                                        For="@(() => _registrationModel.AcceptTerms)">
                                I agree to the 
                                <MudLink Href="/terms" Color="Color.Primary" Target="_blank">Terms of Service</MudLink> 
                                and 
                                <MudLink Href="/privacy" Color="Color.Primary" Target="_blank">Privacy Policy</MudLink>
                            </MudCheckBox>
                        </MudItem>
                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="_registrationModel.ReceiveUpdates" Color="Color.Primary">
                                I want to receive security updates and important notifications (recommended)
                            </MudCheckBox>
                        </MudItem>
                        <MudItem xs="12">
                            <MudDivider />
                        </MudItem>
                        <MudItem xs="12">
                            <div class="text-center">
                                <MudText Typo="Typo.h6" Class="mb-2">Social Login Options</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                    You can also sign up using these providers
                                </MudText>
                                <div class="d-flex justify-center gap-4">
                                    <MudButton Variant="Variant.Outlined" 
                                              StartIcon="@Icons.Custom.Brands.GitHub" 
                                              Color="Color.Secondary"
                                              OnClick="@(() => HandleSocialLogin("GitHub"))">
                                        GitHub
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" 
                                              StartIcon="@Icons.Custom.Brands.Google" 
                                              Color="Color.Secondary"
                                              OnClick="@(() => HandleSocialLogin("Google"))">
                                        Google
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" 
                                              StartIcon="@Icons.Custom.Brands.Microsoft" 
                                              Color="Color.Secondary"
                                              OnClick="@(() => HandleSocialLogin("Microsoft"))">
                                        Microsoft
                                    </MudButton>
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </ChildContent>
            </MudStep>
        </MudStepper>

        <!-- Navigation Buttons -->
        <div class="d-flex justify-space-between mt-6">
            <MudButton Variant="Variant.Text" 
                      Color="Color.Secondary"
                      OnClick="@(() => _stepper.PreviousStepAsync())"
                      Disabled="@(_stepper.ActiveIndex == 0)">
                Previous
            </MudButton>
            
            <div class="d-flex gap-2">
                @if (_stepper.ActiveIndex < 3)
                {
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary"
                              OnClick="@(() => _stepper.NextStepAsync())"
                              Disabled="@(!CanProceedToNext())">
                        Next
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary"
                              OnClick="@HandleRegistration"
                              Disabled="@(_isLoading || !CanCompleteRegistration())"
                              StartIcon="@(_isLoading ? null : Icons.Material.Filled.PersonAdd)">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Creating Account...</span>
                        }
                        else
                        {
                            <span>Create Account</span>
                        }
                    </MudButton>
                }
            </div>
        </div>

        <!-- Existing User Link -->
        <MudDivider Class="mt-6 mb-4" />
        <div class="text-center">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Already have an account?
                <MudLink Href="/login" Color="Color.Primary" Class="font-weight-bold">
                    Sign in here
                </MudLink>
            </MudText>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private MudStepper _stepper = null!;
    private RegistrationModel _registrationModel = new();
    private string _selectedAccountType = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;
    private bool _isLoading = false;

    private void SelectAccountType(string accountType)
    {
        _selectedAccountType = accountType;
        _registrationModel.AccountType = accountType;
    }

    private string GetCardClass(string accountType) =>
        _selectedAccountType == accountType 
            ? "mud-elevation-4 mud-theme-primary" 
            : "mud-elevation-1";

    private string GetAccountTypeDescription(string accountType) => accountType switch
    {
        "Individual" => "Perfect for personal projects, learning, and open source contributions.",
        "Organization" => "Ideal for teams, businesses, and collaborative development projects.",
        "Enterprise" => "Advanced features for large organizations with complex deployment needs.",
        _ => ""
    };

    private async Task<bool> OnStepChangeAsync(StepChangeDirection direction, int targetIndex)
    {
        if (direction == StepChangeDirection.Next)
        {
            return targetIndex switch
            {
                1 => !string.IsNullOrEmpty(_selectedAccountType),
                2 => IsBasicInfoValid(),
                3 => IsSecurityInfoValid(),
                _ => true
            };
        }
        return true;
    }

    private bool CanProceedToNext() => _stepper.ActiveIndex switch
    {
        0 => !string.IsNullOrEmpty(_selectedAccountType),
        1 => IsBasicInfoValid(),
        2 => IsSecurityInfoValid(),
        _ => true
    };

    private bool IsBasicInfoValid() =>
        !string.IsNullOrWhiteSpace(_registrationModel.FirstName) &&
        !string.IsNullOrWhiteSpace(_registrationModel.LastName) &&
        !string.IsNullOrWhiteSpace(_registrationModel.Email) &&
        !string.IsNullOrWhiteSpace(_registrationModel.Username) &&
        (_selectedAccountType == "Individual" || !string.IsNullOrWhiteSpace(_registrationModel.OrganizationName));

    private bool IsSecurityInfoValid() =>
        !string.IsNullOrWhiteSpace(_registrationModel.Password) &&
        _registrationModel.Password == _registrationModel.ConfirmPassword &&
        _registrationModel.Password.Length >= 8;

    private bool CanCompleteRegistration() =>
        IsBasicInfoValid() && IsSecurityInfoValid() && _registrationModel.AcceptTerms;

    private async Task HandleRegistration()
    {
        _isLoading = true;
        try
        {
            var request = new RegisterRequest
            {
                Email = _registrationModel.Email,
                Password = _registrationModel.Password,
                UserName = _registrationModel.Username,
                DisplayName = $"{_registrationModel.FirstName} {_registrationModel.LastName}".Trim(),
                FirstName = _registrationModel.FirstName,
                LastName = _registrationModel.LastName,
                AccountType = _selectedAccountType,
                AcceptTerms = _registrationModel.AcceptTerms,
                ReceiveUpdates = _registrationModel.ReceiveUpdates,
                OrganizationName = _registrationModel.OrganizationName,
                Website = _registrationModel.Website,
                PhoneNumber = _registrationModel.PhoneNumber
            };

            var result = await AuthService.RegisterAsync(request);
            
            if (result.IsSuccess)
            {
                Snackbar.Add("Registration successful! Please check your email to verify your account.", Severity.Success);
                Navigation.NavigateTo("/email-verification");
            }
            else
            {
                Snackbar.Add($"Registration failed: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSocialLogin(string provider)
    {
        Snackbar.Add($"{provider} login will be available soon!", Severity.Info);
        // TODO: Implement social login
    }

    public class RegistrationModel
    {
        [Required(ErrorMessage = "First name is required")]
        [StringLength(50, ErrorMessage = "First name cannot exceed 50 characters")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [StringLength(50, ErrorMessage = "Last name cannot exceed 50 characters")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Username is required")]
        [StringLength(30, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 30 characters")]
        [RegularExpression(@"^[a-zA-Z0-9_-]+$", ErrorMessage = "Username can only contain letters, numbers, hyphens, and underscores")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be between 8 and 100 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public string AccountType { get; set; } = "Individual";
        public string? OrganizationName { get; set; }
        public string? Website { get; set; }
        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "You must accept the terms of service")]
        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms of service")]
        public bool AcceptTerms { get; set; } = false;

        public bool ReceiveUpdates { get; set; } = true;
    }
}