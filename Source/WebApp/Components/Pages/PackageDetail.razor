    private PackageInfo ConvertApiPackageDetailsToPackageInfo(PackageDetails apiPackage)
    {
        return new PackageInfo
        {
            Id = apiPackage.Id,
            Name = apiPackage.Name,
            Description = apiPackage.Description,
            LatestVersion = apiPackage.Version,
            Publisher = new PublisherInfo
            {
                Name = apiPackage.Publisher.ToLower().Replace(" ", "-"),
                DisplayName = apiPackage.Publisher,
                IsVerified = apiPackage.TrustTier != "unverified"
            },
            SecurityGrade = apiPackage.SecurityGrade,
            SecurityScore = CalculateSecurityScore(apiPackage.SecurityGrade),
            TrustTier = ConvertTrustTier(apiPackage.TrustTier),
            WeeklyDownloads = apiPackage.DownloadCount,
            Rating = apiPackage.Rating,
            RatingCount = apiPackage.RatingCount,
            Tags = apiPackage.Tags,
            License = apiPackage.License,
            LastUpdated = apiPackage.LastUpdated,
            CreatedAt = apiPackage.CreatedAt,
            RepositoryUrl = apiPackage.Repository,
            DocumentationUrl = apiPackage.Documentation,
            // Convert additional API fields to PackageInfo properties
            Dependencies = apiPackage.Dependencies?.Select(dep => new DependencyInfo 
            { 
                Name = dep, 
                Version = "latest",
                SecurityGrade = "Unknown",
                SecurityScore = 0,
                License = "Unknown",
                Publisher = "Unknown"
            }).ToList() ?? new List<DependencyInfo>(),
            Versions = apiPackage.Versions?.Select(v => new VersionInfo
            {
                Version = v.Version,
                IsLatest = v.IsLatest,
                IsPrerelease = v.IsPrerelease,
                ReleaseDate = v.ReleaseDate,
                SecurityGrade = v.SecurityGrade,
                Changes = v.Changes.ToArray()
            }).ToList() ?? new List<VersionInfo>(),
            ReadmeContent = apiPackage.ReadmeContent ?? "",
            InstallCommand = apiPackage.InstallCommand ?? $"mcpm install {apiPackage.Name}"
        };
    }

    private double CalculateSecurityScore(string securityGrade)
    {
        return securityGrade.ToUpper() switch
        {
            "A+" => 10.0,
            "A" => 9.0,
            "B+" => 8.5,
            "B" => 8.0,
            "C+" => 7.5,
            "C" => 7.0,
            "D" => 6.0,
            "F" => 4.0,
            _ => 5.0
        };
    }

    private TrustTier ConvertTrustTier(string trustTier)
    {
        return trustTier.ToLower() switch
        {
            "enterprise" => TrustTier.Enterprise,
            "trusted" => TrustTier.CommunityTrusted,
            "verified" => TrustTier.Verified,
            "unverified" => TrustTier.Unverified,
            _ => TrustTier.Unverified
        };
    }

