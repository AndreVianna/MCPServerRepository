        try
        {
            _isSaving = true;
            StateHasChanged();

            var updateRequest = new ProfileUpdateRequest
            {
                DisplayName = _profile!.DisplayName,
                Bio = _profile.Bio,
                Website = _profile.Website
            };
            await ProfileService.UpdateProfileAsync(_profile.Id, updateRequest);
            Snackbar.Add("Profile updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving profile");
            Snackbar.Add("Failed to save profile", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

