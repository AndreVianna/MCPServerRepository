@page "/forgot-password"
@page "/reset-password/{Token}"
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Password Reset - MCP Hub</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudPaper Elevation="2" Class="pa-8">
        <div class="text-center mb-6">
            <MudIcon Icon="@GetStatusIcon()" 
                     Color="@GetStatusColor()" 
                     Style="font-size: 3rem; margin-bottom: 1rem;" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">
                @GetStatusTitle()
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                @GetStatusMessage()
            </MudText>
        </div>

        @if (_resetStatus == ResetStatus.RequestReset)
        {
            <EditForm Model="@_forgotPasswordModel" OnValidSubmit="@HandleForgotPassword">
                <DataAnnotationsValidator />
                <MudGrid Spacing="4">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_forgotPasswordModel.Email"
                                      Label="Email Address"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Required="true"
                                      For="@(() => _forgotPasswordModel.Email)"
                                      FullWidth="true"
                                      HelperText="Enter the email address associated with your account"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton ButtonType="ButtonType.Submit"
                                  Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  FullWidth="true"
                                  Size="Size.Large"
                                  Disabled="@_isLoading"
                                  StartIcon="@(_isLoading ? null : Icons.Material.Filled.Send)">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Sending Reset Link...</span>
                            }
                            else
                            {
                                <span>Send Reset Link</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
        else if (_resetStatus == ResetStatus.EmailSent)
        {
            <MudAlert Severity="Severity.Success" Class="mb-6">
                <strong>Reset link sent!</strong> Check your email for instructions to reset your password.
                The link will expire in 24 hours.
            </MudAlert>
            
            <div class="text-center">
                <MudButton Variant="Variant.Text"
                          Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Email"
                          OnClick="@(() => _resetStatus = ResetStatus.RequestReset)">
                    Send Another Reset Link
                </MudButton>
            </div>
        }
        else if (_resetStatus == ResetStatus.ResetPassword)
        {
            <EditForm Model="@_resetPasswordModel" OnValidSubmit="@HandleResetPassword">
                <DataAnnotationsValidator />
                <MudGrid Spacing="4">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_resetPasswordModel.NewPassword"
                                      Label="New Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showNewPassword = !_showNewPassword)"
                                      Required="true"
                                      For="@(() => _resetPasswordModel.NewPassword)"
                                      FullWidth="true"
                                      Immediate="true" />
                        <PasswordStrengthIndicator Password="@_resetPasswordModel.NewPassword" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_resetPasswordModel.ConfirmPassword"
                                      Label="Confirm New Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)"
                                      Required="true"
                                      For="@(() => _resetPasswordModel.ConfirmPassword)"
                                      FullWidth="true"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton ButtonType="ButtonType.Submit"
                                  Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  FullWidth="true"
                                  Size="Size.Large"
                                  Disabled="@_isLoading"
                                  StartIcon="@(_isLoading ? null : Icons.Material.Filled.Lock)">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Resetting Password...</span>
                            }
                            else
                            {
                                <span>Reset Password</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
        else if (_resetStatus == ResetStatus.Success)
        {
            <MudAlert Severity="Severity.Success" Class="mb-6">
                <strong>Password reset successful!</strong> Your password has been updated.
                You can now sign in with your new password.
            </MudAlert>
            
            <div class="text-center">
                <MudButton Variant="Variant.Filled"
                          Color="Color.Primary"
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Login"
                          Href="/login">
                    Sign In
                </MudButton>
            </div>
        }
        else if (_resetStatus == ResetStatus.Failed)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                <strong>Password reset failed:</strong> @_errorMessage
            </MudAlert>
            
            <div class="text-center">
                <MudButton Variant="Variant.Outlined"
                          Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Refresh"
                          OnClick="@(() => Navigation.NavigateTo("/forgot-password"))"
                          Class="mr-2">
                    Try Again
                </MudButton>
                <MudButton Variant="Variant.Text"
                          Color="Color.Secondary"
                          StartIcon="@Icons.Material.Filled.Home"
                          Href="/">
                    Back to Home
                </MudButton>
            </div>
        }

        <MudDivider Class="mt-6 mb-4" />
        <div class="text-center">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Remember your password?
                <MudLink Href="/login" Color="Color.Primary" Class="font-weight-bold">
                    Sign in here
                </MudLink>
            </MudText>
        </div>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string? Token { get; set; }

    private enum ResetStatus { RequestReset, EmailSent, ResetPassword, Success, Failed }
    
    private ResetStatus _resetStatus = ResetStatus.RequestReset;
    private ForgotPasswordModel _forgotPasswordModel = new();
    private ResetPasswordModel _resetPasswordModel = new();
    private bool _isLoading = false;
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        // If token is provided in URL, show password reset form
        if (!string.IsNullOrEmpty(Token))
        {
            _resetStatus = ResetStatus.ResetPassword;
        }
    }

    private async Task HandleForgotPassword()
    {
        _isLoading = true;
        try
        {
            var result = await AuthService.InitiatePasswordResetAsync(_forgotPasswordModel.Email);
            
            if (result.IsSuccess)
            {
                _resetStatus = ResetStatus.EmailSent;
                Snackbar.Add("Password reset link sent to your email.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Failed to send reset link: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleResetPassword()
    {
        _isLoading = true;
        try
        {
            var result = await AuthService.CompletePasswordResetAsync(Token!, _resetPasswordModel.NewPassword);
            
            if (result.IsSuccess)
            {
                _resetStatus = ResetStatus.Success;
                Snackbar.Add("Password reset successfully!", Severity.Success);
            }
            else
            {
                _resetStatus = ResetStatus.Failed;
                _errorMessage = result.ErrorMessage ?? "Unknown error occurred";
            }
        }
        catch (Exception ex)
        {
            _resetStatus = ResetStatus.Failed;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetStatusIcon() => _resetStatus switch
    {
        ResetStatus.RequestReset => Icons.Material.Filled.LockReset,
        ResetStatus.EmailSent => Icons.Material.Filled.MarkEmailRead,
        ResetStatus.ResetPassword => Icons.Material.Filled.VpnKey,
        ResetStatus.Success => Icons.Material.Filled.CheckCircle,
        ResetStatus.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Lock
    };

    private Color GetStatusColor() => _resetStatus switch
    {
        ResetStatus.Success => Color.Success,
        ResetStatus.Failed => Color.Error,
        _ => Color.Primary
    };

    private string GetStatusTitle() => _resetStatus switch
    {
        ResetStatus.RequestReset => "Reset Your Password",
        ResetStatus.EmailSent => "Check Your Email",
        ResetStatus.ResetPassword => "Create New Password",
        ResetStatus.Success => "Password Reset Complete",
        ResetStatus.Failed => "Reset Failed",
        _ => "Password Reset"
    };

    private string GetStatusMessage() => _resetStatus switch
    {
        ResetStatus.RequestReset => "Enter your email address and we'll send you a link to reset your password.",
        ResetStatus.EmailSent => "We've sent password reset instructions to your email address.",
        ResetStatus.ResetPassword => "Enter your new password below.",
        ResetStatus.Success => "Your password has been successfully reset.",
        ResetStatus.Failed => "We encountered an issue resetting your password.",
        _ => ""
    };

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = string.Empty;
    }

    public class ResetPasswordModel
    {
        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be between 8 and 100 characters")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}