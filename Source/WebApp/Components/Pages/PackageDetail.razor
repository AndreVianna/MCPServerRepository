            <MudText Typo="Typo.h6">Loading package details...</MudText>
        </div>
    </div>
}
else
{
    <!-- Package Not Found -->
    <div class="package-not-found d-flex justify-center align-center" style="min-height: 50vh;">
        <div class="text-center">
            <MudIcon Icon="@Icons.Material.Filled.Search" 
                   Size="Size.Large" 
                   Color="Color.Secondary" 
                   Style="font-size: 4rem;" 
