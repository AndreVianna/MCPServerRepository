    // Helper methods for data transformation and display
    private string GetTrendsSubtitle() => _trendsView switch
    {
        "growth" => "Growth rates across market segments",
        "market-share" => "Market share distribution",
        "adoption" => "Technology adoption patterns",
        _ => "Market trends analysis"
    };

    private Components.UI.Models.ChartType GetTrendsChartType() => _trendsView switch
    {
        "market-share" => Components.UI.Models.ChartType.Donut,
        "adoption" => Components.UI.Models.ChartType.Bar,
        _ => Components.UI.Models.ChartType.Line
    };

    private List<MudBlazor.ChartSeries> GetTrendsChartSeries()
    {
        if (_marketInsights?.Trends == null) return new();

        var customSeries = _trendsView switch
        {
            "growth" => new List<Components.UI.Models.ChartSeries>
            {
                new() { Name = "Growth Rate", Data = _marketInsights.Trends.Select(t => t.Impact).ToArray() }
            },
            "market-share" => new List<Components.UI.Models.ChartSeries>
            {
                new() { Name = "Market Share", Data = _marketInsights.CategoryInsights?.Select(c => (double)c.MarketSize).ToArray() ?? Array.Empty<double>() }
            },
            "adoption" => new List<Components.UI.Models.ChartSeries>
            {
                new() { Name = "Adoption Rate", Data = _marketInsights.Trends.Select(t => t.Impact * 0.8).ToArray() }
            },
            _ => new List<Components.UI.Models.ChartSeries>()
        };

        return ChartSeriesConverter.ToMudBlazor(customSeries);
    }

    private string[] GetTrendsLabels() => _trendsView switch
    {
        "growth" => _marketInsights?.Trends?.Select(t => t.Trend).ToArray() ?? Array.Empty<string>(),
        "market-share" => _marketInsights?.CategoryInsights?.Select(c => c.Category).ToArray() ?? Array.Empty<string>(),
        "adoption" => _marketInsights?.Trends?.Select(t => t.Trend).ToArray() ?? Array.Empty<string>(),
        _ => Array.Empty<string>()
    };

    private IEnumerable<CompetitiveAnalysis> GetFilteredCompetitiveAnalysis()
    {
        if (_marketInsights?.CompetitiveAnalysis == null) return Array.Empty<CompetitiveAnalysis>();

        return string.IsNullOrEmpty(_selectedCompetitiveCategory) 
            ? _marketInsights.CompetitiveAnalysis 
            : _marketInsights.CompetitiveAnalysis.Where(c => c.Category == _selectedCompetitiveCategory);
    }

    private double GetCategoryCompetition(string category)
    {
        return _marketInsights?.CategoryInsights?.FirstOrDefault(c => c.Category == category)?.CompetitionLevel ?? 50.0;
    }

    private string FormatNumber(long number) => number switch
    {
        >= 1000000 => $"{number / 1000000.0:F1}M",
        >= 1000 => $"{number / 1000.0:F1}K",
        _ => number.ToString("N0")
    };

    private string GetCategoryIcon(string category) => category switch
    {
        "AI & ML" => Icons.Material.Filled.Psychology,
        "Web Scraping" => Icons.Material.Filled.Web,
        "Data Processing" => Icons.Material.Filled.DataUsage,
        "API Tools" => Icons.Material.Filled.Api,
        "Security" => Icons.Material.Filled.Security,
        "UI Components" => Icons.Material.Filled.Widgets,
        "Database" => Icons.Material.Filled.Storage,
        "Testing" => Icons.Material.Filled.BugReport,
        _ => Icons.Material.Filled.Category
    };

    private string GetCompetitionLevel(double level) => level switch
    {
        >= 80 => "Very High",
        >= 60 => "High",
        >= 40 => "Medium",
        >= 20 => "Low",
        _ => "Very Low"
    };

    private Color GetCompetitionColor(double level) => level switch
    {
        >= 80 => Color.Error,
        >= 60 => Color.Warning,
        >= 40 => Color.Info,
        _ => Color.Success
    };

    private string GetTrendColor(Services.TrendDirection direction) => direction switch
    {
        Services.TrendDirection.Up => "var(--mud-palette-success)",
        Services.TrendDirection.Down => "var(--mud-palette-error)",
        Services.TrendDirection.Stable => "var(--mud-palette-info)",
        Services.TrendDirection.Volatile => "var(--mud-palette-warning)",
        _ => "var(--mud-palette-secondary)"
    };

    private Color GetTrendChipColor(Services.TrendDirection direction) => direction switch
    {
        Services.TrendDirection.Up => Color.Success,
        Services.TrendDirection.Down => Color.Error,
        Services.TrendDirection.Stable => Color.Info,
        Services.TrendDirection.Volatile => Color.Warning,
        _ => Color.Secondary
    };

    private Color GetDifficultyColor(double difficulty) => difficulty switch
    {
        <= 30 => Color.Success,
        <= 60 => Color.Warning,
        _ => Color.Error
    };

    private Color GetDifficultyTextColor(double difficulty) => difficulty switch
    {
        <= 30 => Color.Success,
        <= 60 => Color.Warning,
        _ => Color.Error
    };

    private string GetDifficultyLabel(double difficulty) => difficulty switch
    {
        <= 30 => "Low",
        <= 60 => "Medium",
        _ => "High"
    };
